//@version=6
strategy("Personal NQ Setup Radar - VWAP / KAMA / Liquidity", overlay=true, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0, process_orders_on_close=false, calc_on_every_tick=true, calc_on_order_fills=true, commission_type=strategy.commission.cash_per_contract, commission_value=4.0, slippage=2, max_lines_count=80, max_labels_count=120)

// Personal TradingView-only setup radar.
// It marks clean setups, draws entry/stop/TP, and closes when the setup thesis weakens.
// Use confirmed bars to avoid repainting.

// ---------------- Inputs ----------------
tradeQty = input.int(1, "Contracts / Paper Size", minval=1, maxval=10)
useNoRepaint = input.bool(true, "Strict No-Repaint")
useSessionFilter = input.bool(true, "RTH Only")
tradeSession = input.session("0930-1600", "Trading Session")
openingRangeMinutes = input.int(15, "Opening Range Minutes", minval=5, maxval=60)

minScore = input.float(72, "Minimum Setup Score", minval=40, maxval=100, step=1)
minEdge = input.float(8, "Minimum Long/Short Edge", minval=0, maxval=40, step=1)
maxChop = input.float(70, "Max Chop Score", minval=20, maxval=100, step=1)
cooldownBars = input.int(4, "Cooldown Bars", minval=0, maxval=100)

emaFastLen = input.int(21, "Fast EMA", minval=5, maxval=100)
emaMidLen = input.int(50, "Trend EMA", minval=10, maxval=200)
emaSlowLen = input.int(200, "Macro EMA", minval=50, maxval=500)
kamaLen = input.int(20, "KAMA / Efficiency Length", minval=5, maxval=80)
atrLen = input.int(14, "ATR Length", minval=2, maxval=100)
adxLen = input.int(14, "ADX Length", minval=2, maxval=100)
adxSmoothing = input.int(14, "ADX Smoothing", minval=2, maxval=100)
volumeLen = input.int(30, "Relative Volume Length", minval=5, maxval=200)
structureLen = input.int(30, "Liquidity Lookback", minval=10, maxval=150)

stopAtrMult = input.float(1.0, "Stop ATR Multiplier", minval=0.25, maxval=5.0, step=0.05)
targetR = input.float(2.0, "Take Profit R", minval=0.5, maxval=8.0, step=0.25)
minRewardR = input.float(1.35, "Minimum Reward R", minval=0.5, maxval=4.0, step=0.05)
maxTargetAtr = input.float(4.0, "Max TP ATR Stretch", minval=1.0, maxval=12.0, step=0.25)
trailAfterR = input.float(0.65, "Trail After R", minval=0.1, maxval=5.0, step=0.05)
trailAtrMult = input.float(0.9, "Trail ATR Multiplier", minval=0.25, maxval=5.0, step=0.05)
profitGivebackR = input.float(0.45, "Close On Giveback R", minval=0.1, maxval=3.0, step=0.05)
maxBarsInTrade = input.int(18, "Max Bars If Weak", minval=2, maxval=200)

showLines = input.bool(true, "Show Entry / Stop / TP Lines")
showPatternLines = input.bool(true, "Show Pattern Lines")
patternPivotLen = input.int(5, "Pattern Pivot Length", minval=2, maxval=20)
showDashboard = input.bool(true, "Show Dashboard")
showAllSetupHints = input.bool(false, "Show Smaller Setup Hints")
showSmartOpportunities = input.bool(true, "Show Smart Opportunity Watch Boxes")
opportunityScoreBuffer = input.float(10, "Opportunity Score Buffer", minval=2, maxval=25, step=1)
opportunityEdgeBuffer = input.float(4, "Opportunity Edge Buffer", minval=0, maxval=15, step=1)
opportunityCooldownBars = input.int(4, "Opportunity Cooldown Bars", minval=0, maxval=50)

useVwapReclaim = input.bool(true, "VWAP Reclaim / Rejection")
useTrendPullback = input.bool(true, "Trend Pullbacks")
useFakeBreakout = input.bool(true, "Fake Breakouts")
useOpeningRange = input.bool(true, "Opening Range Breakouts / Fakeouts")
useLiquiditySweep = input.bool(true, "Liquidity Sweep Reversals")
useCompressionBreakout = input.bool(true, "Compression Breakouts")
usePowerTrendRunner = input.bool(true, "Power Trend Runner")
useKamaFilter = input.bool(true, "KAMA Smart Filter")
useKamaReclaimSetup = input.bool(true, "KAMA Reclaim Setups")
useConfluenceSetup = input.bool(true, "EMA / VWAP Confluence Setups")
useSecondEntrySetup = input.bool(true, "Second Entry / Retest Setups")
usePatternSetups = input.bool(true, "Chart Pattern Setups")

// ---------------- Helpers ----------------
clamp(v, lo, hi) =>
    math.min(math.max(v, lo), hi)

score(cond, points) =>
    cond ? points : 0.0

efficiencyRatio(src, len) =>
    change = math.abs(src - src[len])
    path = 0.0
    for i = 0 to len - 1
        path += math.abs(src[i] - src[i + 1])
    path > 0 ? change / path : 0.0

doji(o, c, h, l) =>
    math.abs(c - o) / math.max(h - l, syminfo.mintick) < 0.20

// ---------------- Core Data ----------------
confirmedOk = not useNoRepaint or barstate.isconfirmed
inSession = not useSessionFilter or not na(time(timeframe.period, tradeSession))
nyHour = hour(time, "America/New_York")
nyMinute = minute(time, "America/New_York")
minutesNow = nyHour * 60 + nyMinute
newDay = ta.change(time("D")) != 0

atr = ta.atr(atrLen)
emaFast = ta.ema(close, emaFastLen)
emaMid = ta.ema(close, emaMidLen)
emaSlow = ta.ema(close, emaSlowLen)
kamaEr = efficiencyRatio(close, kamaLen)
kamaFast = 2.0 / (2.0 + 1.0)
kamaSlow = 2.0 / (30.0 + 1.0)
kamaSc = math.pow(kamaEr * (kamaFast - kamaSlow) + kamaSlow, 2)
var float kamaValue = na
kamaValue := na(kamaValue[1]) ? close : kamaValue[1] + kamaSc * (close - kamaValue[1])
kamaSlope = (kamaValue - nz(kamaValue[3], kamaValue)) / math.max(atr, syminfo.mintick)
atrBase = ta.sma(atr, 100)
atrRatio = atrBase > 0 ? atr / atrBase : 1.0
vwapRaw = ta.vwap(hlc3)
vwap = na(vwapRaw) ? emaFast : vwapRaw
vwapSlope = (vwap - nz(vwap[5], vwap)) / math.max(atr, syminfo.mintick)
[plusDi, minusDi, adx] = ta.dmi(adxLen, adxSmoothing)

relVolume = volume / math.max(ta.sma(volume, volumeLen), 1)
candleRange = math.max(high - low, syminfo.mintick)
body = math.abs(close - open)
bodyPct = body / candleRange
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
closeNearHigh = (close - low) / candleRange >= 0.62
closeNearLow = (high - close) / candleRange >= 0.62

priorHigh = ta.highest(high, structureLen)[1]
priorLow = ta.lowest(low, structureLen)[1]
swingHigh = ta.highest(high, 8)[1]
swingLow = ta.lowest(low, 8)[1]
rangeHigh = ta.highest(high, structureLen)
rangeLow = ta.lowest(low, structureLen)
rangeSpan = math.max(rangeHigh - rangeLow, syminfo.mintick)
rangePosition = (close - rangeLow) / rangeSpan
distVwapAtr = math.abs(close - vwap) / math.max(atr, syminfo.mintick)

bbBasis = ta.sma(close, 20)
bbDev = ta.stdev(close, 20) * 2.0
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
kcBasis = ta.ema(close, 20)
kcRange = ta.atr(20) * 1.5
squeezeOn = bbUpper < kcBasis + kcRange and bbLower > kcBasis - kcRange
squeezeReleaseLong = squeezeOn[1] and close > bbUpper and closeNearHigh and relVolume >= 1.0
squeezeReleaseShort = squeezeOn[1] and close < bbLower and closeNearLow and relVolume >= 1.0

overlap = math.max(0.0, math.min(high, high[1]) - math.max(low, low[1])) / candleRange
alternating = (close > open and close[1] < open[1]) or (close < open and close[1] > open[1])
middleOfRange = rangePosition > 0.35 and rangePosition < 0.65 and distVwapAtr > 0.45
chopScore = clamp(18 + score(adx < 16, 18) + score(math.abs(vwapSlope) < 0.03, 10) + score(overlap > 0.55, 12) + score(alternating, 8) + score(middleOfRange, 10) + score(atrRatio < 0.75, 6) - score(adx > 22 and efficiencyRatio(close, kamaLen) > 0.35, 18), 0, 100)

bullTrend = close > emaMid and emaFast > emaMid and emaMid >= emaSlow and close > kamaValue and kamaSlope >= -0.05
bearTrend = close < emaMid and emaFast < emaMid and emaMid <= emaSlow and close < kamaValue and kamaSlope <= 0.05
powerBull = bullTrend and adx >= 22 and close > vwap and vwapSlope > 0 and relVolume >= 0.75
powerBear = bearTrend and adx >= 22 and close < vwap and vwapSlope < 0 and relVolume >= 0.75

// ---------------- Opening Range ----------------
var float orHigh = na
var float orLow = na
if newDay
    orHigh := na
    orLow := na

orStart = 9 * 60 + 30
orEnd = orStart + openingRangeMinutes
inOpeningRange = minutesNow >= orStart and minutesNow < orEnd
afterOpeningRange = minutesNow >= orEnd
if inOpeningRange
    orHigh := na(orHigh) ? high : math.max(orHigh, high)
    orLow := na(orLow) ? low : math.min(orLow, low)
orReady = useOpeningRange and afterOpeningRange and not na(orHigh) and not na(orLow)

// ---------------- Chart Pattern Memory ----------------
// Pivots confirm after patternPivotLen bars, so these pattern lines do not use future bars for live decisions.
pivotHigh = ta.pivothigh(high, patternPivotLen, patternPivotLen)
pivotLow = ta.pivotlow(low, patternPivotLen, patternPivotLen)
var float prevPivotHigh = na
var float lastPivotHigh = na
var int prevPivotHighBar = na
var int lastPivotHighBar = na
var float prevPivotLow = na
var float lastPivotLow = na
var int prevPivotLowBar = na
var int lastPivotLowBar = na

if not na(pivotHigh)
    prevPivotHigh := lastPivotHigh
    prevPivotHighBar := lastPivotHighBar
    lastPivotHigh := pivotHigh
    lastPivotHighBar := bar_index - patternPivotLen

if not na(pivotLow)
    prevPivotLow := lastPivotLow
    prevPivotLowBar := lastPivotLowBar
    lastPivotLow := pivotLow
    lastPivotLowBar := bar_index - patternPivotLen

insideBarPrior = high[1] < high[2] and low[1] > low[2]
doubleTopShort = usePatternSetups and not na(prevPivotHigh) and not na(lastPivotHigh) and math.abs(lastPivotHigh - prevPivotHigh) <= atr * 0.65 and close < math.min(lastPivotHigh, prevPivotHigh) - atr * 0.10 and upperWick > body * 0.60
doubleBottomLong = usePatternSetups and not na(prevPivotLow) and not na(lastPivotLow) and math.abs(lastPivotLow - prevPivotLow) <= atr * 0.65 and close > math.max(lastPivotLow, prevPivotLow) + atr * 0.10 and lowerWick > body * 0.60
triangleReady = usePatternSetups and not na(prevPivotHigh) and not na(lastPivotHigh) and not na(prevPivotLow) and not na(lastPivotLow) and lastPivotHigh < prevPivotHigh and lastPivotLow > prevPivotLow and squeezeOn
triangleBreakLong = triangleReady and close > lastPivotHigh and closeNearHigh and relVolume >= 0.85
triangleBreakShort = triangleReady and close < lastPivotLow and closeNearLow and relVolume >= 0.85
insideBreakLong = usePatternSetups and insideBarPrior and close > high[1] and closeNearHigh and relVolume >= 0.75 and not doji(open[1], close[1], high[1], low[1])
insideBreakShort = usePatternSetups and insideBarPrior and close < low[1] and closeNearLow and relVolume >= 0.75 and not doji(open[1], close[1], high[1], low[1])

// ---------------- Setups ----------------
vwapReclaimLong = useVwapReclaim and low <= vwap and close > vwap and close > open and closeNearHigh and relVolume >= 0.75
vwapRejectShort = useVwapReclaim and high >= vwap and close < vwap and close < open and closeNearLow and relVolume >= 0.75

trendPullbackLong = useTrendPullback and bullTrend and low <= emaFast + atr * 0.25 and close > emaFast and closeNearHigh and relVolume >= 0.65
trendPullbackShort = useTrendPullback and bearTrend and high >= emaFast - atr * 0.25 and close < emaFast and closeNearLow and relVolume >= 0.65

fakeBreakoutShort = useFakeBreakout and high > priorHigh and close < priorHigh and upperWick > body * 1.15 and relVolume >= 0.75
fakeBreakoutLong = useFakeBreakout and low < priorLow and close > priorLow and lowerWick > body * 1.15 and relVolume >= 0.75

orBreakoutLong = orReady and close > orHigh and closeNearHigh and relVolume >= 0.90 and not fakeBreakoutShort
orBreakoutShort = orReady and close < orLow and closeNearLow and relVolume >= 0.90 and not fakeBreakoutLong
orFakeoutLong = orReady and low < orLow and close > orLow and closeNearHigh and relVolume >= 0.75
orFakeoutShort = orReady and high > orHigh and close < orHigh and closeNearLow and relVolume >= 0.75

liquiditySweepLong = useLiquiditySweep and (low < priorLow or low < swingLow) and close > math.max(priorLow, swingLow) and lowerWick > upperWick and closeNearHigh
liquiditySweepShort = useLiquiditySweep and (high > priorHigh or high > swingHigh) and close < math.min(priorHigh, swingHigh) and upperWick > lowerWick and closeNearLow

compressionBreakoutLong = useCompressionBreakout and squeezeReleaseLong and close > priorHigh and close > vwap
compressionBreakoutShort = useCompressionBreakout and squeezeReleaseShort and close < priorLow and close < vwap

powerTrendLong = usePowerTrendRunner and powerBull and close > high[1] and bodyPct >= 0.35 and closeNearHigh
powerTrendShort = usePowerTrendRunner and powerBear and close < low[1] and bodyPct >= 0.35 and closeNearLow

kamaReclaimLong = useKamaReclaimSetup and low <= kamaValue and close > kamaValue and kamaSlope > 0 and closeNearHigh and close > open and relVolume >= 0.70
kamaRejectShort = useKamaReclaimSetup and high >= kamaValue and close < kamaValue and kamaSlope < 0 and closeNearLow and close < open and relVolume >= 0.70

confluenceLong = useConfluenceSetup and bullTrend and low <= math.max(emaFast, vwap) + atr * 0.20 and close > math.max(emaFast, vwap) and closeNearHigh and relVolume >= 0.70
confluenceShort = useConfluenceSetup and bearTrend and high >= math.min(emaFast, vwap) - atr * 0.20 and close < math.min(emaFast, vwap) and closeNearLow and relVolume >= 0.70

barsSinceLongTrap = ta.barssince(fakeBreakoutLong or liquiditySweepLong or orFakeoutLong)
barsSinceShortTrap = ta.barssince(fakeBreakoutShort or liquiditySweepShort or orFakeoutShort)
secondEntryLong = useSecondEntrySetup and barsSinceLongTrap > 0 and barsSinceLongTrap <= 5 and close > high[1] and close > vwap and closeNearHigh and relVolume >= 0.70
secondEntryShort = useSecondEntrySetup and barsSinceShortTrap > 0 and barsSinceShortTrap <= 5 and close < low[1] and close < vwap and closeNearLow and relVolume >= 0.70

chartPatternLong = doubleBottomLong or triangleBreakLong or insideBreakLong
chartPatternShort = doubleTopShort or triangleBreakShort or insideBreakShort
chartPatternLongName = doubleBottomLong ? "Double Bottom Reclaim" : triangleBreakLong ? "Triangle Breakout Long" : insideBreakLong ? "Inside Bar Breakout Long" : "Pattern Long"
chartPatternShortName = doubleTopShort ? "Double Top Rejection" : triangleBreakShort ? "Triangle Breakdown Short" : insideBreakShort ? "Inside Bar Breakdown Short" : "Pattern Short"
patternEventLong = chartPatternLong and not chartPatternLong[1]
patternEventShort = chartPatternShort and not chartPatternShort[1]

// ---------------- Scoring ----------------
locationLong = vwapReclaimLong or trendPullbackLong or fakeBreakoutLong or orFakeoutLong or liquiditySweepLong or compressionBreakoutLong or powerTrendLong or kamaReclaimLong or confluenceLong or secondEntryLong or chartPatternLong
locationShort = vwapRejectShort or trendPullbackShort or fakeBreakoutShort or orFakeoutShort or liquiditySweepShort or compressionBreakoutShort or powerTrendShort or kamaRejectShort or confluenceShort or secondEntryShort or chartPatternShort
kamaOkLong = not useKamaFilter or close >= kamaValue or kamaSlope > 0
kamaOkShort = not useKamaFilter or close <= kamaValue or kamaSlope < 0
doNotChaseLong = distVwapAtr > 2.6 or (close > priorHigh and upperWick > body * 1.7) or (rangePosition > 0.90 and not powerBull)
doNotChaseShort = distVwapAtr > 2.6 or (close < priorLow and lowerWick > body * 1.7) or (rangePosition < 0.10 and not powerBear)

longScore = clamp(40 + score(bullTrend, 12) + score(powerBull, 10) + score(close > vwap, 8) + score(vwapSlope > 0, 5) + score(relVolume >= 1.0, 7) + score(closeNearHigh, 6) + score(kamaOkLong, 6) + score(vwapReclaimLong, 12) + score(trendPullbackLong, 12) + score(fakeBreakoutLong or orFakeoutLong or liquiditySweepLong, 14) + score(orBreakoutLong, 10) + score(compressionBreakoutLong, 12) + score(powerTrendLong, 12) + score(kamaReclaimLong or confluenceLong, 10) + score(secondEntryLong, 9) + score(chartPatternLong, 10) - score(chopScore > maxChop, 14) - score(doNotChaseLong, 12) - score(bearTrend, 10), 0, 100)
shortScore = clamp(40 + score(bearTrend, 12) + score(powerBear, 10) + score(close < vwap, 8) + score(vwapSlope < 0, 5) + score(relVolume >= 1.0, 7) + score(closeNearLow, 6) + score(kamaOkShort, 6) + score(vwapRejectShort, 12) + score(trendPullbackShort, 12) + score(fakeBreakoutShort or orFakeoutShort or liquiditySweepShort, 14) + score(orBreakoutShort, 10) + score(compressionBreakoutShort, 12) + score(powerTrendShort, 12) + score(kamaRejectShort or confluenceShort, 10) + score(secondEntryShort, 9) + score(chartPatternShort, 10) - score(chopScore > maxChop, 14) - score(doNotChaseShort, 12) - score(bullTrend, 10), 0, 100)
trapLongScore = clamp(28 + score(fakeBreakoutLong, 22) + score(orFakeoutLong, 20) + score(liquiditySweepLong, 22) + score(secondEntryLong, 12) + score(lowerWick > upperWick, 8) + score(closeNearHigh, 8) + score(relVolume >= 1.0, 7) + score(close > vwap, 5) + score(kamaOkLong, 5) - score(chopScore > maxChop, 8) - score(doNotChaseLong, 8), 0, 100)
trapShortScore = clamp(28 + score(fakeBreakoutShort, 22) + score(orFakeoutShort, 20) + score(liquiditySweepShort, 22) + score(secondEntryShort, 12) + score(upperWick > lowerWick, 8) + score(closeNearLow, 8) + score(relVolume >= 1.0, 7) + score(close < vwap, 5) + score(kamaOkShort, 5) - score(chopScore > maxChop, 8) - score(doNotChaseShort, 8), 0, 100)
edge = longScore - shortScore

longSetup = chartPatternLong ? chartPatternLongName : confluenceLong ? "EMA/VWAP Confluence Long" : kamaReclaimLong ? "KAMA Reclaim Long" : secondEntryLong ? "Second Entry Trap Long" : vwapReclaimLong ? "VWAP Reclaim Long" : trendPullbackLong ? "Trend Pullback Long" : fakeBreakoutLong ? "Fake Breakdown Reclaim" : orFakeoutLong ? "Opening Range Fakeout Long" : orBreakoutLong ? "Opening Range Breakout Long" : liquiditySweepLong ? "Liquidity Sweep Reversal Long" : compressionBreakoutLong ? "Compression Breakout Long" : powerTrendLong ? "Power Trend Runner Long" : "Long Setup"
shortSetup = chartPatternShort ? chartPatternShortName : confluenceShort ? "EMA/VWAP Confluence Short" : kamaRejectShort ? "KAMA Rejection Short" : secondEntryShort ? "Second Entry Trap Short" : vwapRejectShort ? "VWAP Rejection Short" : trendPullbackShort ? "Trend Pullback Short" : fakeBreakoutShort ? "Fake Breakout Short" : orFakeoutShort ? "Opening Range Fakeout Short" : orBreakoutShort ? "Opening Range Breakdown Short" : liquiditySweepShort ? "Liquidity Sweep Reversal Short" : compressionBreakoutShort ? "Compression Breakdown Short" : powerTrendShort ? "Power Trend Runner Short" : "Short Setup"

longTrapReason = fakeBreakoutLong ? "Trap: sellers broke prior low, but price reclaimed it with a strong lower wick." : orFakeoutLong ? "Trap: sellers pushed below the opening range low, then price closed back above it." : liquiditySweepLong ? "Trap: sell stops under liquidity were swept, then buyers stepped back in." : secondEntryLong ? "Trap: first reclaim held and the second push confirmed buyers still control it." : ""
shortTrapReason = fakeBreakoutShort ? "Trap: buyers broke prior high, but price rejected back below it with a strong upper wick." : orFakeoutShort ? "Trap: buyers pushed above the opening range high, then price closed back below it." : liquiditySweepShort ? "Trap: buy stops over liquidity were swept, then sellers stepped back in." : secondEntryShort ? "Trap: first rejection held and the second push confirmed sellers still control it." : ""
trapScoreText = "Trap L/S Scores: " + str.tostring(trapLongScore, "#") + " / " + str.tostring(trapShortScore, "#")
longReason = str.length(longTrapReason) > 0 ? longTrapReason + " " + trapScoreText : chartPatternLong ? "Pattern: " + chartPatternLongName + " with score/volume confirmation." : confluenceLong ? "Confluence: EMA, VWAP, and trend bias are stacked under price." : kamaReclaimLong ? "KAMA reclaim: price recovered the adaptive trend line with momentum." : vwapReclaimLong ? "VWAP reclaim: price flushed into VWAP and closed back above it." : trendPullbackLong ? "Trend pullback: bullish trend held the fast EMA support." : compressionBreakoutLong ? "Compression breakout: squeeze released upward with volume." : powerTrendLong ? "Power trend: strong trend momentum is still expanding." : "Long setup passed the score gate."
shortReason = str.length(shortTrapReason) > 0 ? shortTrapReason + " " + trapScoreText : chartPatternShort ? "Pattern: " + chartPatternShortName + " with score/volume confirmation." : confluenceShort ? "Confluence: EMA, VWAP, and trend bias are stacked above price." : kamaRejectShort ? "KAMA rejection: price failed the adaptive trend line with momentum." : vwapRejectShort ? "VWAP rejection: price tested VWAP and closed back below it." : trendPullbackShort ? "Trend pullback: bearish trend held the fast EMA resistance." : compressionBreakoutShort ? "Compression breakdown: squeeze released downward with volume." : powerTrendShort ? "Power trend: strong bearish momentum is still expanding." : "Short setup passed the score gate."

// ---------------- Risk Plan ----------------
longStopStructure = math.min(nz(swingLow, low), low) - syminfo.mintick * 2
shortStopStructure = math.max(nz(swingHigh, high), high) + syminfo.mintick * 2
longStop = math.min(close - syminfo.mintick * 4, math.max(close - atr * stopAtrMult, longStopStructure))
shortStop = math.max(close + syminfo.mintick * 4, math.min(close + atr * stopAtrMult, shortStopStructure))
longRisk = math.max(close - longStop, syminfo.mintick)
shortRisk = math.max(shortStop - close, syminfo.mintick)
rawLongTarget = close + longRisk * targetR
rawShortTarget = close - shortRisk * targetR
nearestLongTarget = close + atr * maxTargetAtr
nearestLongTarget := not na(priorHigh) and priorHigh > close ? math.min(nearestLongTarget, priorHigh) : nearestLongTarget
nearestLongTarget := not na(swingHigh) and swingHigh > close ? math.min(nearestLongTarget, swingHigh) : nearestLongTarget
nearestLongTarget := orReady and orHigh > close ? math.min(nearestLongTarget, orHigh) : nearestLongTarget
nearestLongTarget := not na(lastPivotHigh) and lastPivotHigh > close ? math.min(nearestLongTarget, lastPivotHigh) : nearestLongTarget
nearestShortTarget = close - atr * maxTargetAtr
nearestShortTarget := not na(priorLow) and priorLow < close ? math.max(nearestShortTarget, priorLow) : nearestShortTarget
nearestShortTarget := not na(swingLow) and swingLow < close ? math.max(nearestShortTarget, swingLow) : nearestShortTarget
nearestShortTarget := orReady and orLow < close ? math.max(nearestShortTarget, orLow) : nearestShortTarget
nearestShortTarget := not na(lastPivotLow) and lastPivotLow < close ? math.max(nearestShortTarget, lastPivotLow) : nearestShortTarget
longTarget = math.min(rawLongTarget, nearestLongTarget)
shortTarget = math.max(rawShortTarget, nearestShortTarget)
rewardOkLong = (longTarget - close) / longRisk >= minRewardR or powerTrendLong or compressionBreakoutLong
rewardOkShort = (close - shortTarget) / shortRisk >= minRewardR or powerTrendShort or compressionBreakoutShort

var int lastSignalBar = na
cooldownOk = na(lastSignalBar) or bar_index - lastSignalBar > cooldownBars
baseGate = confirmedOk and inSession and cooldownOk and chopScore <= maxChop and strategy.position_size == 0
longSignal = baseGate and longScore >= minScore and edge >= minEdge and locationLong and kamaOkLong and not doNotChaseLong and rewardOkLong
shortSignal = baseGate and shortScore >= minScore and edge <= -minEdge and locationShort and kamaOkShort and not doNotChaseShort and rewardOkShort
longAlert = "LONG " + syminfo.ticker + " | Setup: " + longSetup + " | Entry: " + str.tostring(close, format.mintick) + " | Stop: " + str.tostring(longStop, format.mintick) + " | Take Profit: " + str.tostring(longTarget, format.mintick) + " | Score: " + str.tostring(longScore, "#") + " | Edge: " + str.tostring(edge, "#") + " | Reason: " + longReason
shortAlert = "SHORT " + syminfo.ticker + " | Setup: " + shortSetup + " | Entry: " + str.tostring(close, format.mintick) + " | Stop: " + str.tostring(shortStop, format.mintick) + " | Take Profit: " + str.tostring(shortTarget, format.mintick) + " | Score: " + str.tostring(shortScore, "#") + " | Edge: " + str.tostring(edge, "#") + " | Reason: " + shortReason
longTooltip = "Setup: " + longSetup + "\nEntry: " + str.tostring(close, format.mintick) + "\nStop Loss: " + str.tostring(longStop, format.mintick) + "\nTake Profit: " + str.tostring(longTarget, format.mintick) + "\nScore L/S: " + str.tostring(longScore, "#") + " / " + str.tostring(shortScore, "#") + "\nTrap L/S: " + str.tostring(trapLongScore, "#") + " / " + str.tostring(trapShortScore, "#") + "\nEdge: " + str.tostring(edge, "#") + "\nReason: " + longReason
shortTooltip = "Setup: " + shortSetup + "\nEntry: " + str.tostring(close, format.mintick) + "\nStop Loss: " + str.tostring(shortStop, format.mintick) + "\nTake Profit: " + str.tostring(shortTarget, format.mintick) + "\nScore L/S: " + str.tostring(longScore, "#") + " / " + str.tostring(shortScore, "#") + "\nTrap L/S: " + str.tostring(trapLongScore, "#") + " / " + str.tostring(trapShortScore, "#") + "\nEdge: " + str.tostring(edge, "#") + "\nReason: " + shortReason

var int lastOpportunityBar = na
opportunityCooldownOk = na(lastOpportunityBar) or bar_index - lastOpportunityBar > opportunityCooldownBars
watchBase = showSmartOpportunities and confirmedOk and inSession and opportunityCooldownOk and strategy.position_size == 0 and chopScore <= maxChop + 8 and cooldownOk
watchLong = watchBase and not longSignal and locationLong and kamaOkLong and not doNotChaseLong and rewardOkLong and longScore >= minScore - opportunityScoreBuffer and edge >= minEdge - opportunityEdgeBuffer and longScore > shortScore
watchShort = watchBase and not shortSignal and locationShort and kamaOkShort and not doNotChaseShort and rewardOkShort and shortScore >= minScore - opportunityScoreBuffer and edge <= -minEdge + opportunityEdgeBuffer and shortScore > longScore
watchLongTooltip = "Watch Long Opportunity\nSetup: " + longSetup + "\nEntry area: " + str.tostring(close, format.mintick) + "\nStop idea: " + str.tostring(longStop, format.mintick) + "\nTarget idea: " + str.tostring(longTarget, format.mintick) + "\nScore L/S: " + str.tostring(longScore, "#") + " / " + str.tostring(shortScore, "#") + "\nTrap L/S: " + str.tostring(trapLongScore, "#") + " / " + str.tostring(trapShortScore, "#") + "\nWhy not full signal: it is close, but still below the stricter LONG gate."
watchShortTooltip = "Watch Short Opportunity\nSetup: " + shortSetup + "\nEntry area: " + str.tostring(close, format.mintick) + "\nStop idea: " + str.tostring(shortStop, format.mintick) + "\nTarget idea: " + str.tostring(shortTarget, format.mintick) + "\nScore L/S: " + str.tostring(longScore, "#") + " / " + str.tostring(shortScore, "#") + "\nTrap L/S: " + str.tostring(trapLongScore, "#") + " / " + str.tostring(trapShortScore, "#") + "\nWhy not full signal: it is close, but still below the stricter SHORT gate."

var float activeEntry = na
var float activeStop = na
var float activeTarget = na
var float activeRisk = na
var float activeBest = na
var string activeSetup = ""
var int activeEntryBar = na
var line entryLine = na
var line stopLine = na
var line targetLine = na

// ---------------- Entries ----------------
if longSignal
    lastSignalBar := bar_index
    activeEntry := close
    activeStop := longStop
    activeTarget := longTarget
    activeRisk := longRisk
    activeBest := high
    activeSetup := longSetup
    activeEntryBar := bar_index
    strategy.entry("Long", strategy.long, qty=tradeQty, alert_message=longAlert)
    strategy.exit("Long Risk", from_entry="Long", stop=activeStop, limit=activeTarget, alert_message="EXIT LONG risk/target")
    alert(longAlert, alert.freq_once_per_bar_close)
    if showLines
        if not na(entryLine)
            line.delete(entryLine)
        if not na(stopLine)
            line.delete(stopLine)
        if not na(targetLine)
            line.delete(targetLine)
        entryLine := line.new(bar_index, activeEntry, bar_index + 60, activeEntry, color=color.new(color.white, 0), width=2, extend=extend.right)
        stopLine := line.new(bar_index, activeStop, bar_index + 60, activeStop, color=color.new(color.red, 0), width=2, extend=extend.right)
        targetLine := line.new(bar_index, activeTarget, bar_index + 60, activeTarget, color=color.new(color.lime, 0), width=2, extend=extend.right)
    label.new(bar_index, low, "LONG", style=label.style_label_up, color=color.new(color.lime, 0), textcolor=color.black, size=size.small, tooltip=longTooltip)

if shortSignal
    lastSignalBar := bar_index
    activeEntry := close
    activeStop := shortStop
    activeTarget := shortTarget
    activeRisk := shortRisk
    activeBest := low
    activeSetup := shortSetup
    activeEntryBar := bar_index
    strategy.entry("Short", strategy.short, qty=tradeQty, alert_message=shortAlert)
    strategy.exit("Short Risk", from_entry="Short", stop=activeStop, limit=activeTarget, alert_message="EXIT SHORT risk/target")
    alert(shortAlert, alert.freq_once_per_bar_close)
    if showLines
        if not na(entryLine)
            line.delete(entryLine)
        if not na(stopLine)
            line.delete(stopLine)
        if not na(targetLine)
            line.delete(targetLine)
        entryLine := line.new(bar_index, activeEntry, bar_index + 60, activeEntry, color=color.new(color.white, 0), width=2, extend=extend.right)
        stopLine := line.new(bar_index, activeStop, bar_index + 60, activeStop, color=color.new(color.red, 0), width=2, extend=extend.right)
        targetLine := line.new(bar_index, activeTarget, bar_index + 60, activeTarget, color=color.new(color.lime, 0), width=2, extend=extend.right)
    label.new(bar_index, high, "SHORT", style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.small, tooltip=shortTooltip)

// ---------------- Trade Management ----------------
barsInTrade = not na(activeEntryBar) ? bar_index - activeEntryBar : 0
safeRisk = math.max(nz(activeRisk, atr), syminfo.mintick)
longOpenR = strategy.position_size > 0 ? (close - strategy.position_avg_price) / safeRisk : 0.0
shortOpenR = strategy.position_size < 0 ? (strategy.position_avg_price - close) / safeRisk : 0.0

if strategy.position_size > 0
    activeBest := na(activeBest) ? high : math.max(activeBest, high)
    bestR = (activeBest - strategy.position_avg_price) / safeRisk
    givebackR = math.max(bestR - longOpenR, 0.0)
    if longOpenR >= trailAfterR
        activeStop := math.max(activeStop, close - atr * trailAtrMult, strategy.position_avg_price + safeRisk * 0.05)
        strategy.exit("Long Risk", from_entry="Long", stop=activeStop, limit=activeTarget, alert_message="EXIT LONG trailing/target")
    closeLong = (longOpenR <= -0.65 and (close < vwap or shortScore > longScore)) or (bestR >= 0.8 and givebackR >= profitGivebackR and longScore < shortScore + 6) or (barsInTrade >= maxBarsInTrade and longOpenR < 0.25) or (close < emaFast and close < vwap and longScore < 62)
    if closeLong and confirmedOk
        strategy.close("Long", alert_message="CLOSE LONG " + activeSetup)
        label.new(bar_index, high, "CLOSE", style=label.style_label_down, color=color.new(color.yellow, 0), textcolor=color.black, size=size.tiny, tooltip="Close Long\nSetup: " + activeSetup + "\nReason: thesis weakened or risk/target logic fired.")

if strategy.position_size < 0
    activeBest := na(activeBest) ? low : math.min(activeBest, low)
    bestR = (strategy.position_avg_price - activeBest) / safeRisk
    givebackR = math.max(bestR - shortOpenR, 0.0)
    if shortOpenR >= trailAfterR
        activeStop := math.min(activeStop, close + atr * trailAtrMult, strategy.position_avg_price - safeRisk * 0.05)
        strategy.exit("Short Risk", from_entry="Short", stop=activeStop, limit=activeTarget, alert_message="EXIT SHORT trailing/target")
    closeShort = (shortOpenR <= -0.65 and (close > vwap or longScore > shortScore)) or (bestR >= 0.8 and givebackR >= profitGivebackR and shortScore < longScore + 6) or (barsInTrade >= maxBarsInTrade and shortOpenR < 0.25) or (close > emaFast and close > vwap and shortScore < 62)
    if closeShort and confirmedOk
        strategy.close("Short", alert_message="CLOSE SHORT " + activeSetup)
        label.new(bar_index, low, "CLOSE", style=label.style_label_up, color=color.new(color.yellow, 0), textcolor=color.black, size=size.tiny, tooltip="Close Short\nSetup: " + activeSetup + "\nReason: thesis weakened or risk/target logic fired.")

if strategy.position_size == 0
    activeEntry := na
    activeStop := na
    activeTarget := na
    activeRisk := na
    activeBest := na
    activeEntryBar := na

// ---------------- Pattern Lines ----------------
var line patternLineOne = na
var line patternLineTwo = na
var label patternLabel = na

if showPatternLines and confirmedOk and (patternEventLong or patternEventShort)
    if not na(patternLineOne)
        line.delete(patternLineOne)
    if not na(patternLineTwo)
        line.delete(patternLineTwo)
    if not na(patternLabel)
        label.delete(patternLabel)
    if doubleBottomLong and not na(prevPivotLowBar) and not na(lastPivotLowBar)
        patternLineOne := line.new(prevPivotLowBar, prevPivotLow, lastPivotLowBar, lastPivotLow, color=color.new(color.lime, 0), width=2, extend=extend.right)
        patternLabel := label.new(bar_index, low, "DB LONG", style=label.style_label_up, color=color.new(color.lime, 10), textcolor=color.black, size=size.tiny, tooltip="Pattern: Double Bottom Reclaim Long\nTwo nearby lows held, price reclaimed above them, and buyers showed rejection.")
    else if doubleTopShort and not na(prevPivotHighBar) and not na(lastPivotHighBar)
        patternLineOne := line.new(prevPivotHighBar, prevPivotHigh, lastPivotHighBar, lastPivotHigh, color=color.new(color.red, 0), width=2, extend=extend.right)
        patternLabel := label.new(bar_index, high, "DT SHORT", style=label.style_label_down, color=color.new(color.red, 10), textcolor=color.white, size=size.tiny, tooltip="Pattern: Double Top Rejection Short\nTwo nearby highs rejected, price failed back under resistance, and sellers showed rejection.")
    else if triangleBreakLong and not na(prevPivotHighBar) and not na(lastPivotHighBar) and not na(prevPivotLowBar) and not na(lastPivotLowBar)
        patternLineOne := line.new(prevPivotHighBar, prevPivotHigh, lastPivotHighBar, lastPivotHigh, color=color.new(color.lime, 0), width=2, extend=extend.right)
        patternLineTwo := line.new(prevPivotLowBar, prevPivotLow, lastPivotLowBar, lastPivotLow, color=color.new(color.lime, 35), width=2, extend=extend.right)
        patternLabel := label.new(bar_index, low, "TRI LONG", style=label.style_label_up, color=color.new(color.lime, 10), textcolor=color.black, size=size.tiny, tooltip="Pattern: Triangle Breakout Long\nLower highs and higher lows compressed, then price broke the upper line with confirmation.")
    else if triangleBreakShort and not na(prevPivotHighBar) and not na(lastPivotHighBar) and not na(prevPivotLowBar) and not na(lastPivotLowBar)
        patternLineOne := line.new(prevPivotHighBar, prevPivotHigh, lastPivotHighBar, lastPivotHigh, color=color.new(color.red, 35), width=2, extend=extend.right)
        patternLineTwo := line.new(prevPivotLowBar, prevPivotLow, lastPivotLowBar, lastPivotLow, color=color.new(color.red, 0), width=2, extend=extend.right)
        patternLabel := label.new(bar_index, high, "TRI SHORT", style=label.style_label_down, color=color.new(color.red, 10), textcolor=color.white, size=size.tiny, tooltip="Pattern: Triangle Breakdown Short\nLower highs and higher lows compressed, then price broke the lower line with confirmation.")
    else if insideBreakLong
        patternLineOne := line.new(bar_index - 1, high[1], bar_index + 20, high[1], color=color.new(color.lime, 0), width=2, extend=extend.right)
        patternLineTwo := line.new(bar_index - 1, low[1], bar_index + 20, low[1], color=color.new(color.lime, 65), width=1, extend=extend.right)
        patternLabel := label.new(bar_index, low, "IB LONG", style=label.style_label_up, color=color.new(color.lime, 10), textcolor=color.black, size=size.tiny, tooltip="Pattern: Inside Bar Breakout Long\nThe prior candle compressed inside the previous range, then price broke upward with confirmation.")
    else if insideBreakShort
        patternLineOne := line.new(bar_index - 1, low[1], bar_index + 20, low[1], color=color.new(color.red, 0), width=2, extend=extend.right)
        patternLineTwo := line.new(bar_index - 1, high[1], bar_index + 20, high[1], color=color.new(color.red, 65), width=1, extend=extend.right)
        patternLabel := label.new(bar_index, high, "IB SHORT", style=label.style_label_down, color=color.new(color.red, 10), textcolor=color.white, size=size.tiny, tooltip="Pattern: Inside Bar Breakdown Short\nThe prior candle compressed inside the previous range, then price broke downward with confirmation.")

// ---------------- Visuals ----------------
plot(emaFast, "Fast EMA", color=color.new(color.orange, 0))
plot(emaMid, "Trend EMA", color=color.new(color.blue, 0), linewidth=2)
plot(emaSlow, "Macro EMA", color=color.new(color.fuchsia, 0), linewidth=2)
plot(kamaValue, "KAMA", color=color.new(color.yellow, 0), linewidth=2)
plot(vwap, "VWAP", color=color.new(color.white, 0), linewidth=2)
plot(orHigh, "Opening Range High", color=color.new(color.lime, 55), style=plot.style_linebr)
plot(orLow, "Opening Range Low", color=color.new(color.red, 55), style=plot.style_linebr)
plot(priorHigh, "Liquidity High", color=color.new(color.red, 82), style=plot.style_linebr)
plot(priorLow, "Liquidity Low", color=color.new(color.lime, 82), style=plot.style_linebr)

plotshape(showAllSetupHints and vwapReclaimLong, title="VWAP Reclaim Hint", style=shape.triangleup, color=color.new(color.lime, 55), location=location.belowbar, size=size.tiny, text="VWAP")
plotshape(showAllSetupHints and vwapRejectShort, title="VWAP Reject Hint", style=shape.triangledown, color=color.new(color.red, 55), location=location.abovebar, size=size.tiny, text="VWAP")
plotshape(showAllSetupHints and (fakeBreakoutLong or liquiditySweepLong or orFakeoutLong), title="Trap Long Hint", style=shape.circle, color=color.new(color.aqua, 45), location=location.belowbar, size=size.tiny, text="TRAP")
plotshape(showAllSetupHints and (fakeBreakoutShort or liquiditySweepShort or orFakeoutShort), title="Trap Short Hint", style=shape.circle, color=color.new(color.orange, 45), location=location.abovebar, size=size.tiny, text="TRAP")

if showAllSetupHints and confirmedOk and str.length(longTrapReason) > 0
    label.new(bar_index, low, "TRAP L", style=label.style_label_up, color=color.new(color.aqua, 15), textcolor=color.black, size=size.tiny, tooltip=longTrapReason + "\n" + trapScoreText)

if showAllSetupHints and confirmedOk and str.length(shortTrapReason) > 0
    label.new(bar_index, high, "TRAP S", style=label.style_label_down, color=color.new(color.orange, 15), textcolor=color.black, size=size.tiny, tooltip=shortTrapReason + "\n" + trapScoreText)

if watchLong
    lastOpportunityBar := bar_index
    label.new(bar_index, low, "WATCH L", style=label.style_label_up, color=color.new(color.lime, 72), textcolor=color.white, size=size.tiny, tooltip=watchLongTooltip)

if watchShort
    lastOpportunityBar := bar_index
    label.new(bar_index, high, "WATCH S", style=label.style_label_down, color=color.new(color.red, 72), textcolor=color.white, size=size.tiny, tooltip=watchShortTooltip)

plotshape(longSignal, title="Clean Long Setup Marker", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 40), text="", size=size.tiny)
plotshape(shortSignal, title="Clean Short Setup Marker", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 40), text="", size=size.tiny)

// ---------------- Alerts ----------------
alertcondition(longSignal, title="Personal Radar Long", message="LONG setup fired. For dynamic entry/stop/TP, use Any alert() function call or {{strategy.order.alert_message}}.")
alertcondition(shortSignal, title="Personal Radar Short", message="SHORT setup fired. For dynamic entry/stop/TP, use Any alert() function call or {{strategy.order.alert_message}}.")
alertcondition(strategy.position_size > 0 and close < activeStop, title="Long Stop Area", message="LONG stop area touched.")
alertcondition(strategy.position_size < 0 and close > activeStop, title="Short Stop Area", message="SHORT stop area touched.")

// ---------------- Dashboard ----------------
status = not inSession ? "Outside session" : chopScore > maxChop ? "Chop / wait" : longScore > shortScore ? "Long watch" : shortScore > longScore ? "Short watch" : "Neutral"
bestSetup = longScore >= shortScore ? longSetup : shortSetup
var table dash = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 12), border_color=color.new(color.white, 72), border_width=1)
if showDashboard and barstate.islast
    table.cell(dash, 0, 0, "Setup Radar", text_color=color.white, bgcolor=color.new(color.teal, 55))
    table.cell(dash, 1, 0, status, text_color=chopScore <= maxChop ? color.lime : color.orange, bgcolor=color.new(color.teal, 55))
    table.cell(dash, 0, 1, "Best Setup", text_color=color.silver)
    table.cell(dash, 1, 1, bestSetup, text_color=longScore >= shortScore ? color.lime : color.orange)
    table.cell(dash, 0, 2, "Scores L/S", text_color=color.silver)
    table.cell(dash, 1, 2, str.tostring(longScore, "#") + " / " + str.tostring(shortScore, "#"), text_color=edge >= 0 ? color.lime : color.orange)
    table.cell(dash, 0, 3, "VWAP", text_color=color.silver)
    table.cell(dash, 1, 3, close > vwap ? "Above" : "Below", text_color=close > vwap ? color.lime : color.orange)
    table.cell(dash, 0, 4, "KAMA", text_color=color.silver)
    table.cell(dash, 1, 4, close > kamaValue ? "Bull" : "Bear", text_color=close > kamaValue ? color.lime : color.orange)
    table.cell(dash, 0, 5, "Chop", text_color=color.silver)
    table.cell(dash, 1, 5, str.tostring(chopScore, "#"), text_color=chopScore <= maxChop ? color.lime : color.orange)
    table.cell(dash, 0, 6, "Regime", text_color=color.silver)
    table.cell(dash, 1, 6, powerBull ? "Power Bull" : powerBear ? "Power Bear" : bullTrend ? "Bull" : bearTrend ? "Bear" : "Range", text_color=powerBull or bullTrend ? color.lime : powerBear or bearTrend ? color.orange : color.silver)
    table.cell(dash, 0, 7, "Trap L/S", text_color=color.silver)
    table.cell(dash, 1, 7, str.tostring(trapLongScore, "#") + " / " + str.tostring(trapShortScore, "#"), text_color=trapLongScore >= trapShortScore ? color.lime : color.orange)
    table.cell(dash, 0, 8, "Risk Lines", text_color=color.silver)
    table.cell(dash, 1, 8, strategy.position_size == 0 ? "Waiting" : "Active", text_color=strategy.position_size == 0 ? color.silver : color.lime)
