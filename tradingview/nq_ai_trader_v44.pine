//@version=6
//@strategy_alert_message {{strategy.order.alert_message}}
strategy("NQ Quantum Pro AI Strategy - Python Sync", shorttitle="NQ Quantum Sync", overlay=true, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0, margin_long=10, margin_short=10, process_orders_on_close=false, calc_on_every_tick=false, calc_on_order_fills=false, commission_type=strategy.commission.cash_per_contract, commission_value=4.0, slippage=2, max_lines_count=500, max_labels_count=500)

// This is the TradingView-side sync of the Python/Databento research engine.
// It is intentionally NQ-only, bar-close, lookahead_off, and no repaint.
// It can run on any chart timeframe; lower timeframes use stricter quality guards.

var string GRP_CORE = "Core"
var string GRP_SCORE = "Python Sync Scoring"
var string GRP_RISK = "Risk / Exits"
var string GRP_DISP = "Display"

tradeQty = input.int(1, "Contracts / Paper Size", minval=1, maxval=10, group=GRP_CORE)
accountSize = input.float(100000.0, "Paper Account Size", minval=1000.0, step=1000.0, group=GRP_CORE)
nqPointValue = input.float(20.0, "NQ $ / Point", minval=0.01, step=0.25, group=GRP_CORE)
useNqLock = input.bool(true, "NQ Only", group=GRP_CORE)
useNoRepaint = input.bool(true, "Strict No-Repaint Bar Close", group=GRP_CORE)
useRollingBacktest = input.bool(true, "Rolling 4Y Backtest Window", group=GRP_CORE)
rollingBacktestYears = input.int(4, "Rolling Backtest Years", minval=1, maxval=20, group=GRP_CORE)
useSessionFilter = input.bool(true, "RTH Only", group=GRP_CORE)
tradeSession = input.session("0930-1600", "Trading Session", group=GRP_CORE)
webhookTag = input.string("nq-quantum-pro-ai-sync", "Webhook Tag", group=GRP_CORE)

minSetupScore = input.float(80.0, "Minimum Setup Score", minval=40.0, maxval=100.0, step=1.0, group=GRP_SCORE)
minEdge = input.float(10.0, "Minimum Edge", minval=0.0, maxval=50.0, step=1.0, group=GRP_SCORE)
minVotes = input.int(4, "Minimum Votes", minval=1, maxval=8, group=GRP_SCORE)
maxChopScore = input.float(60.0, "Max Chop Score", minval=20.0, maxval=100.0, step=1.0, group=GRP_SCORE)
maxUncertainty = input.float(56.0, "Max Uncertainty", minval=10.0, maxval=100.0, step=1.0, group=GRP_SCORE)
minRelativeVolume = input.float(0.75, "Min Relative Volume", minval=0.0, maxval=5.0, step=0.05, group=GRP_SCORE)
minBodyPct = input.float(0.30, "Min Body %", minval=0.0, maxval=1.0, step=0.05, group=GRP_SCORE)
minKaufmanRatio = input.float(0.34, "Min Kaufman Ratio", minval=0.0, maxval=1.0, step=0.05, group=GRP_SCORE)
atrExpansionMult = input.float(1.05, "ATR Expansion Mult", minval=0.1, maxval=5.0, step=0.01, group=GRP_SCORE)

atrLen = input.int(14, "ATR Length", minval=2, maxval=100, group=GRP_RISK)
maxRiskPoints = input.float(16.0, "Max Risk Points", minval=1.0, maxval=200.0, step=0.25, group=GRP_RISK)
targetR = input.float(1.75, "Target R", minval=0.25, maxval=10.0, step=0.05, group=GRP_RISK)
trailAfterR = input.float(0.35, "Trail After R", minval=0.0, maxval=5.0, step=0.05, group=GRP_RISK)
trailAtrMult = input.float(0.65, "Trail ATR Mult", minval=0.1, maxval=5.0, step=0.05, group=GRP_RISK)
profitGivebackR = input.float(0.25, "Profit Giveback R", minval=0.05, maxval=5.0, step=0.05, group=GRP_RISK)
earlyAdverseR = input.float(0.40, "Early Adverse R", minval=0.05, maxval=5.0, step=0.05, group=GRP_RISK)
maxBarsInTrade = input.int(8, "Max Bars In Trade", minval=1, maxval=100, group=GRP_RISK)
maxTradesPerDay = input.int(8, "Max Trades Per Day", minval=1, maxval=100, group=GRP_RISK)
maxLossesPerDay = input.int(2, "Max Losses Per Day", minval=1, maxval=25, group=GRP_RISK)
maxConsecutiveLosses = input.int(2, "Max Consecutive Losses", minval=1, maxval=20, group=GRP_RISK)
dailyLossCap = input.float(650.0, "Daily Loss Cap ($)", minval=50.0, maxval=25000.0, step=50.0, group=GRP_RISK)
cooldownBars = input.int(4, "Cooldown Bars", minval=0, maxval=200, group=GRP_RISK)
useGreenLineGuard = input.bool(true, "Green-Line Equity Guard", group=GRP_RISK)
equityGuardLen = input.int(50, "Equity Guard MA Bars", minval=5, maxval=500, group=GRP_RISK)
drawdownCautionDollars = input.float(2500.0, "Caution Mode Drawdown ($)", minval=100.0, maxval=50000.0, step=100.0, group=GRP_RISK)
dailyProfitLockStart = input.float(800.0, "Protect Day After Profit ($)", minval=50.0, maxval=25000.0, step=50.0, group=GRP_RISK)
dailyProfitGiveback = input.float(300.0, "Max Daily Profit Giveback ($)", minval=25.0, maxval=25000.0, step=25.0, group=GRP_RISK)
postLossScorePenalty = input.float(4.0, "Extra Score Needed After Loss", minval=0.0, maxval=20.0, step=0.5, group=GRP_RISK)

showLabels = input.bool(true, "Show Entry Labels", group=GRP_DISP)
showLines = input.bool(true, "Show Entry / Stop / Target Lines", group=GRP_DISP)
showDashboard = input.bool(true, "Show Dashboard", group=GRP_DISP)
showKeyLevels = input.bool(true, "Show Key Levels", group=GRP_DISP)

clamp(v, lo, hi) =>
    math.min(math.max(v, lo), hi)

scoreBool(cond, points) =>
    cond ? points : 0.0

safeDiv(num, den) =>
    den == 0.0 ? 0.0 : num / den

// ---------------- Core / No-Repaint Gate ----------------
confirmedOk = not useNoRepaint or barstate.isconfirmed
tickerUpper = str.upper(syminfo.ticker)
symbolOk = not useNqLock or str.contains(tickerUpper, "NQ")
inSession = not useSessionFilter or not na(time(timeframe.period, tradeSession))
newDay = ta.change(time("D")) != 0
nyHour = hour(time, "America/New_York")
nyMinute = minute(time, "America/New_York")
nyMinutes = nyHour * 60 + nyMinute
nearSessionClose = inSession and nyMinutes >= 950
backtestStart = timestamp("America/New_York", year(timenow, "America/New_York") - rollingBacktestYears, month(timenow, "America/New_York"), dayofmonth(timenow, "America/New_York"), 0, 0)
windowOk = not useRollingBacktest or time >= backtestStart
maxContractsByAccount = int(math.max(1, math.floor(accountSize / math.max(close * nqPointValue, 1.0))))
actualQty = math.max(1, math.min(tradeQty, maxContractsByAccount))

// ---------------- Python-Sync Features ----------------
emaFast = ta.ema(close, 50)
emaSlow = ta.ema(close, 200)
emaPullback = ta.ema(close, 21)
atr = ta.atr(atrLen)
atrBase = ta.sma(atr, 100)
atrRatio = safeDiv(atr, atrBase)
volumeBase = ta.sma(volume, 30)
relativeVolume = volumeBase > 0.0 ? volume / volumeBase : 1.0
priorHigh = ta.highest(high, 20)[1]
priorLow = ta.lowest(low, 20)[1]
rangeHigh = ta.highest(high, 20)
rangeLow = ta.lowest(low, 20)
candleRange = math.max(high - low, syminfo.mintick)
body = math.abs(close - open)
bodyPct = body / candleRange
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
closeNearHigh = (close - low) / candleRange >= 0.60
closeNearLow = (high - close) / candleRange >= 0.60
overlap = math.max(0.0, math.min(high, high[1]) - math.max(low, low[1])) / candleRange
alternating = (close > open and close[1] < open[1]) or (close < open and close[1] > open[1])
kaufmanLen = 10
kaufmanChange = math.abs(close - nz(close[kaufmanLen], close))
kaufmanPath = ta.sma(math.abs(close - close[1]), kaufmanLen) * kaufmanLen
kaufmanRatio = safeDiv(kaufmanChange, kaufmanPath)

upMove = high - high[1]
downMove = low[1] - low
plusDm = upMove > downMove and upMove > 0.0 ? upMove : 0.0
minusDm = downMove > upMove and downMove > 0.0 ? downMove : 0.0
[plusDi, minusDi, trendStrength] = ta.dmi(14, 14)

vwapRaw = ta.vwap(hlc3)
vwapValue = na(vwapRaw) ? emaPullback : vwapRaw
vwapSlope = (vwapValue - nz(vwapValue[3], vwapValue)) / math.max(atr, syminfo.mintick)
bbBasis = ta.sma(close, 20)
bbDev = ta.stdev(close, 20) * 2.0
bbWidth = bbBasis != 0.0 ? (bbDev * 2.0) / bbBasis * 100.0 : 0.0
bbWidthAvg = ta.sma(bbWidth, 20)
rangeSpan = math.max(rangeHigh - rangeLow, syminfo.mintick)
rangePosition = (close - rangeLow) / rangeSpan
distVwapAtr = math.abs(close - vwapValue) / math.max(atr, syminfo.mintick)
middleOfRange = rangePosition > 0.35 and rangePosition < 0.65 and distVwapAtr > 0.45

[htfClose, htfFast, htfSlow] = request.security(syminfo.tickerid, "240", [close[1], ta.ema(close, 50)[1], ta.ema(close, 200)[1]], barmerge.gaps_off, barmerge.lookahead_off)
htfBull = htfClose > htfSlow and htfFast >= htfSlow
htfBear = htfClose < htfSlow and htfFast <= htfSlow

bullTrend = close > emaSlow and emaFast > emaSlow
bearTrend = close < emaSlow and emaFast < emaSlow
volumeOk = relativeVolume >= minRelativeVolume
candleOk = bodyPct >= minBodyPct
volatilityOk = na(atrBase) or atr <= atrBase * 2.35
chopScore = clamp(18.0 + scoreBool(trendStrength < 15.0, 18) + scoreBool(math.abs(vwapSlope) < 0.03, 10) + scoreBool(overlap > 0.52, 12) + scoreBool(alternating, 8) + scoreBool(bbWidth < bbWidthAvg, 8) + scoreBool(middleOfRange, 10) - scoreBool(kaufmanRatio >= minKaufmanRatio and trendStrength >= 15.0, 16), 0.0, 100.0)

reclaimLong = low <= vwapValue and close > vwapValue and close > open
rejectShort = high >= vwapValue and close < vwapValue and close < open
breakLong = close > priorHigh and closeNearHigh and volumeOk
breakShort = close < priorLow and closeNearLow and volumeOk
sweepLong = low < priorLow and close > priorLow and lowerWick > upperWick
sweepShort = high > priorHigh and close < priorHigh and upperWick > lowerWick
fakeoutLongRisk = high > priorHigh and close < priorHigh and upperWick > body * 1.2
fakeoutShortRisk = low < priorLow and close > priorLow and lowerWick > body * 1.2
doNotChaseLong = distVwapAtr > 2.4 or (close > priorHigh and upperWick > body * 1.5)
doNotChaseShort = distVwapAtr > 2.4 or (close < priorLow and lowerWick > body * 1.5)

reversalLong = (sweepLong or reclaimLong or (low <= emaPullback + atr * 0.35 and close > emaPullback)) and close > open and closeNearHigh and lowerWick > upperWick and volumeOk and (htfBull or sweepLong)
reversalShort = (sweepShort or rejectShort or (high >= emaPullback - atr * 0.35 and close < emaPullback)) and close < open and closeNearLow and upperWick > lowerWick and volumeOk and (htfBear or sweepShort)
kaufmanLong = bullTrend and htfBull and kaufmanRatio >= minKaufmanRatio and close > emaFast and close > open and volumeOk
kaufmanShort = bearTrend and htfBear and kaufmanRatio >= minKaufmanRatio and close < emaFast and close < open and volumeOk
atrLong = bullTrend and htfBull and atrRatio >= atrExpansionMult and candleOk and closeNearHigh and volumeOk and (breakLong or reclaimLong or close > emaFast)
atrShort = bearTrend and htfBear and atrRatio >= atrExpansionMult and candleOk and closeNearLow and volumeOk and (breakShort or rejectShort or close < emaFast)

bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1] and (close - low) / candleRange >= 0.62
bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1] and (high - close) / candleRange >= 0.62
bullPin = lowerWick >= math.max(body * 1.45, syminfo.mintick * 4.0) and (close - low) / candleRange >= 0.58 and (low <= priorLow + atr * 0.35 or reclaimLong)
bearPin = upperWick >= math.max(body * 1.45, syminfo.mintick * 4.0) and (high - close) / candleRange >= 0.58 and (high >= priorHigh - atr * 0.35 or rejectShort)
trendPullbackLong = bullTrend and htfBull and low <= emaPullback + atr * 0.35 and close > emaPullback and (close - low) / candleRange >= 0.58
trendPullbackShort = bearTrend and htfBear and high >= emaPullback - atr * 0.35 and close < emaPullback and (high - close) / candleRange >= 0.58
quantumFvgLong = low > high[2] and (low - high[2]) >= atr * 0.18 and close > open and volumeOk
quantumFvgShort = high < low[2] and (low[2] - high) >= atr * 0.18 and close < open and volumeOk

// ---------------- Risk State / Adaptive Learning ----------------
var int tradesToday = 0
var int lossesToday = 0
var int lossStreak = 0
var int winsToday = 0
var int reviewedClosedTrades = 0
var int lastTradeBar = na
var float dayStartEquity = strategy.equity
var float dayPeakEquity = strategy.equity
var float activeStop = na
var float activeTarget = na
var float activeRisk = na
var float activeBest = na
var int activeEntryBar = na
var string activeSetup = "None"
var float adaptiveLongPenalty = 0.0
var float adaptiveShortPenalty = 0.0
var float trendPenalty = 0.0
var float reversalPenalty = 0.0
var float breakoutPenalty = 0.0
var float fvgPenalty = 0.0

if newDay
    tradesToday := 0
    lossesToday := 0
    lossStreak := 0
    winsToday := 0
    dayStartEquity := strategy.equity
    dayPeakEquity := strategy.equity

dayPeakEquity := math.max(nz(dayPeakEquity, strategy.equity), strategy.equity)
dailyPnl = strategy.equity - dayStartEquity

if strategy.closedtrades > reviewedClosedTrades
    lastIdx = strategy.closedtrades - 1
    pnl = strategy.closedtrades.profit(lastIdx)
    entryName = strategy.closedtrades.entry_id(lastIdx)
    lostTrade = pnl < 0
    if lostTrade
        lossesToday += 1
        lossStreak += 1
        adaptiveLongPenalty := entryName == "Quantum Long" ? math.min(18.0, adaptiveLongPenalty + 4.0) : adaptiveLongPenalty
        adaptiveShortPenalty := entryName == "Quantum Short" ? math.min(18.0, adaptiveShortPenalty + 4.0) : adaptiveShortPenalty
        trendPenalty := activeSetup == "QuantumTrendPullback" ? math.min(16.0, trendPenalty + 3.0) : trendPenalty
        reversalPenalty := activeSetup == "QuantumReversal" ? math.min(16.0, reversalPenalty + 3.0) : reversalPenalty
        breakoutPenalty := activeSetup == "QuantumBreakout" ? math.min(16.0, breakoutPenalty + 3.5) : breakoutPenalty
        fvgPenalty := activeSetup == "QuantumFVG" ? math.min(16.0, fvgPenalty + 3.0) : fvgPenalty
    else
        winsToday += 1
        lossStreak := 0
        adaptiveLongPenalty := entryName == "Quantum Long" ? math.max(0.0, adaptiveLongPenalty - 2.0) : adaptiveLongPenalty
        adaptiveShortPenalty := entryName == "Quantum Short" ? math.max(0.0, adaptiveShortPenalty - 2.0) : adaptiveShortPenalty
        trendPenalty := activeSetup == "QuantumTrendPullback" ? math.max(0.0, trendPenalty - 1.25) : trendPenalty
        reversalPenalty := activeSetup == "QuantumReversal" ? math.max(0.0, reversalPenalty - 1.25) : reversalPenalty
        breakoutPenalty := activeSetup == "QuantumBreakout" ? math.max(0.0, breakoutPenalty - 1.25) : breakoutPenalty
        fvgPenalty := activeSetup == "QuantumFVG" ? math.max(0.0, fvgPenalty - 1.25) : fvgPenalty
    reviewedClosedTrades := strategy.closedtrades

tfMinutes = timeframe.in_seconds(timeframe.period) / 60.0
fastTfMode = tfMinutes <= 5.0
intradayTfMode = tfMinutes < 60.0
equityMa = ta.sma(strategy.equity, equityGuardLen)
equityPeakLookback = ta.highest(strategy.equity, equityGuardLen * 4)
equityCaution = useGreenLineGuard and not na(equityMa) and strategy.equity < equityMa
drawdownCaution = useGreenLineGuard and not na(equityPeakLookback) and equityPeakLookback - strategy.equity >= drawdownCautionDollars
dailyProfitGivebackLock = useGreenLineGuard and dayPeakEquity - dayStartEquity >= dailyProfitLockStart and dayPeakEquity - strategy.equity >= dailyProfitGiveback

baseLongScore = clamp(42.0 + scoreBool(bullTrend, 12) + scoreBool(htfBull, 10) + scoreBool(close > vwapValue, 8) + scoreBool(vwapSlope > 0, 5) + scoreBool(volumeOk, 7) + scoreBool(relativeVolume >= 1.1, 5) + scoreBool(kaufmanRatio >= minKaufmanRatio, 8) + scoreBool(trendStrength >= 15.0, 6) + scoreBool(closeNearHigh, 5) + scoreBool(reclaimLong or sweepLong, 8) + scoreBool(reversalLong, 9) + scoreBool(breakLong, 6) - scoreBool(chopScore > 72.0, 12) - scoreBool(fakeoutLongRisk, 12) - scoreBool(doNotChaseLong, 10) - scoreBool(bearTrend and htfBear, 12), 0.0, 100.0)
baseShortScore = clamp(42.0 + scoreBool(bearTrend, 12) + scoreBool(htfBear, 10) + scoreBool(close < vwapValue, 8) + scoreBool(vwapSlope < 0, 5) + scoreBool(volumeOk, 7) + scoreBool(relativeVolume >= 1.1, 5) + scoreBool(kaufmanRatio >= minKaufmanRatio, 8) + scoreBool(trendStrength >= 15.0, 6) + scoreBool(closeNearLow, 5) + scoreBool(rejectShort or sweepShort, 8) + scoreBool(reversalShort, 9) + scoreBool(breakShort, 6) - scoreBool(chopScore > 72.0, 12) - scoreBool(fakeoutShortRisk, 12) - scoreBool(doNotChaseShort, 10) - scoreBool(bullTrend and htfBull, 12), 0.0, 100.0)

quantumFvgLong := quantumFvgLong and baseLongScore >= 56
quantumFvgShort := quantumFvgShort and baseShortScore >= 56
longSetup = trendPullbackLong ? "QuantumTrendPullback" : reversalLong or bullPin ? "QuantumReversal" : breakLong ? "QuantumBreakout" : quantumFvgLong ? "QuantumFVG" : "QuantumLong"
shortSetup = trendPullbackShort ? "QuantumTrendPullback" : reversalShort or bearPin ? "QuantumReversal" : breakShort ? "QuantumBreakout" : quantumFvgShort ? "QuantumFVG" : "QuantumShort"
longSetupPenalty = longSetup == "QuantumTrendPullback" ? trendPenalty : longSetup == "QuantumReversal" ? reversalPenalty : longSetup == "QuantumBreakout" ? breakoutPenalty : longSetup == "QuantumFVG" ? fvgPenalty : 0.0
shortSetupPenalty = shortSetup == "QuantumTrendPullback" ? trendPenalty : shortSetup == "QuantumReversal" ? reversalPenalty : shortSetup == "QuantumBreakout" ? breakoutPenalty : shortSetup == "QuantumFVG" ? fvgPenalty : 0.0
longVotes = (trendPullbackLong ? 1 : 0) + (reversalLong ? 1 : 0) + (breakLong ? 1 : 0) + (quantumFvgLong ? 1 : 0) + (htfBull ? 1 : 0) + (close > vwapValue ? 1 : 0) + (closeNearHigh ? 1 : 0) + (volumeOk ? 1 : 0)
shortVotes = (trendPullbackShort ? 1 : 0) + (reversalShort ? 1 : 0) + (breakShort ? 1 : 0) + (quantumFvgShort ? 1 : 0) + (htfBear ? 1 : 0) + (close < vwapValue ? 1 : 0) + (closeNearLow ? 1 : 0) + (volumeOk ? 1 : 0)
uncertainty = clamp(18.0 + scoreBool(chopScore > maxChopScore, 18) + scoreBool(middleOfRange, 12) + scoreBool(relativeVolume < 0.70, 8) + scoreBool(atrRatio > 1.55, 8) + scoreBool(equityCaution, 8) + scoreBool(drawdownCaution, 10), 0.0, 100.0)
longScore = clamp(baseLongScore + longVotes * 2.0 + scoreBool(bullEngulf, 4) + scoreBool(bullPin, 4) + scoreBool(quantumFvgLong, 6) + scoreBool(trendPullbackLong, 5) + scoreBool(dailyPnl > 0 and winsToday > lossesToday, 2) - scoreBool(uncertainty > maxUncertainty, 8) - adaptiveLongPenalty - longSetupPenalty, 0.0, 100.0)
shortScore = clamp(baseShortScore + shortVotes * 2.0 + scoreBool(bearEngulf, 4) + scoreBool(bearPin, 4) + scoreBool(quantumFvgShort, 6) + scoreBool(trendPullbackShort, 5) + scoreBool(dailyPnl > 0 and winsToday > lossesToday, 2) - scoreBool(uncertainty > maxUncertainty, 8) - adaptiveShortPenalty - shortSetupPenalty, 0.0, 100.0)

dailyLossLock = dailyPnl <= -dailyLossCap
lossLock = lossesToday >= maxLossesPerDay or lossStreak >= maxConsecutiveLosses
tradeCountLock = tradesToday >= maxTradesPerDay
cooldownOk = na(lastTradeBar) or bar_index - lastTradeBar > cooldownBars
greenLineLock = dailyProfitGivebackLock
gateOk = confirmedOk and symbolOk and inSession and not nearSessionClose and windowOk and volatilityOk and not dailyLossLock and not lossLock and not tradeCountLock and not greenLineLock and cooldownOk and strategy.position_size == 0

adaptiveMinScore = minSetupScore + lossStreak * postLossScorePenalty + scoreBool(equityCaution, 4) + scoreBool(drawdownCaution, 6) + scoreBool(fastTfMode, 2)
adaptiveMinEdge = minEdge + scoreBool(equityCaution or drawdownCaution, 3) + scoreBool(fastTfMode, 1)
adaptiveMaxChop = maxChopScore - scoreBool(lossStreak > 0, 4) - scoreBool(fastTfMode, 3)
adaptiveMaxUncertainty = maxUncertainty - scoreBool(lossStreak > 0, 4) - scoreBool(drawdownCaution, 4)
trendClarityLong = plusDi > minusDi and close >= emaPullback and vwapSlope >= -0.02
trendClarityShort = minusDi > plusDi and close <= emaPullback and vwapSlope <= 0.02
qualityLong = trendClarityLong or reversalLong or sweepLong
qualityShort = trendClarityShort or reversalShort or sweepShort

longRaw = longVotes >= minVotes and longScore >= adaptiveMinScore and longScore >= shortScore + adaptiveMinEdge and uncertainty <= adaptiveMaxUncertainty and chopScore <= adaptiveMaxChop and not fakeoutLongRisk and not doNotChaseLong and qualityLong and (trendPullbackLong or reversalLong or breakLong or quantumFvgLong)
shortRaw = shortVotes >= minVotes and shortScore >= adaptiveMinScore and shortScore >= longScore + adaptiveMinEdge and uncertainty <= adaptiveMaxUncertainty and chopScore <= adaptiveMaxChop and not fakeoutShortRisk and not doNotChaseShort and qualityShort and (trendPullbackShort or reversalShort or breakShort or quantumFvgShort)
longSignal = gateOk and longRaw and not shortRaw
shortSignal = gateOk and shortRaw and not longRaw

longStop = math.max(math.max(close - atr * 1.05, priorLow - syminfo.mintick * 2.0), close - maxRiskPoints)
shortStop = math.min(math.min(close + atr * 1.05, priorHigh + syminfo.mintick * 2.0), close + maxRiskPoints)
longRisk = math.max(close - longStop, syminfo.mintick)
shortRisk = math.max(shortStop - close, syminfo.mintick)
longTarget = close + longRisk * targetR
shortTarget = close - shortRisk * targetR

longMsg = '{"source":"tradingview","bot":"nq_quantum_pro_ai","action":"BUY","ticker":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","setup":"' + longSetup + '","entry":' + str.tostring(close, format.mintick) + ',"stop":' + str.tostring(longStop, format.mintick) + ',"target":' + str.tostring(longTarget, format.mintick) + ',"qty":' + str.tostring(actualQty) + ',"score":' + str.tostring(longScore, "#.##") + ',"opposing_score":' + str.tostring(shortScore, "#.##") + ',"votes":' + str.tostring(longVotes) + ',"regime":"GreenLineAdaptive","uncertainty":' + str.tostring(uncertainty, "#.##") + ',"reason":"Adaptive no-repaint NQ engine: ' + longSetup + '","tag":"' + webhookTag + '"}'
shortMsg = '{"source":"tradingview","bot":"nq_quantum_pro_ai","action":"SELL","ticker":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","setup":"' + shortSetup + '","entry":' + str.tostring(close, format.mintick) + ',"stop":' + str.tostring(shortStop, format.mintick) + ',"target":' + str.tostring(shortTarget, format.mintick) + ',"qty":' + str.tostring(actualQty) + ',"score":' + str.tostring(shortScore, "#.##") + ',"opposing_score":' + str.tostring(longScore, "#.##") + ',"votes":' + str.tostring(shortVotes) + ',"regime":"GreenLineAdaptive","uncertainty":' + str.tostring(uncertainty, "#.##") + ',"reason":"Adaptive no-repaint NQ engine: ' + shortSetup + '","tag":"' + webhookTag + '"}'
exitLongMsg = '{"source":"tradingview","bot":"nq_quantum_pro_ai","action":"EXIT_LONG","ticker":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","price":' + str.tostring(close, format.mintick) + ',"reason":"python-sync exit: stop target thesis fail trail or session","tag":"' + webhookTag + '"}'
exitShortMsg = '{"source":"tradingview","bot":"nq_quantum_pro_ai","action":"EXIT_SHORT","ticker":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","price":' + str.tostring(close, format.mintick) + ',"reason":"python-sync exit: stop target thesis fail trail or session","tag":"' + webhookTag + '"}'

longTooltip = "NQ Quantum Sync LONG\nSetup: " + longSetup + "\nEntry: " + str.tostring(close, format.mintick) + "\nStop: " + str.tostring(longStop, format.mintick) + "\nTarget: " + str.tostring(longTarget, format.mintick) + "\nScore L/S: " + str.tostring(longScore, "#") + " / " + str.tostring(shortScore, "#") + "\nVotes: " + str.tostring(longVotes) + "\nAdaptive min: " + str.tostring(adaptiveMinScore, "#") + "\nChop/Unc: " + str.tostring(chopScore, "#") + " / " + str.tostring(uncertainty, "#") + "\nGreen guard: " + (equityCaution or drawdownCaution ? "caution" : "normal")
shortTooltip = "NQ Quantum Sync SHORT\nSetup: " + shortSetup + "\nEntry: " + str.tostring(close, format.mintick) + "\nStop: " + str.tostring(shortStop, format.mintick) + "\nTarget: " + str.tostring(shortTarget, format.mintick) + "\nScore L/S: " + str.tostring(longScore, "#") + " / " + str.tostring(shortScore, "#") + "\nVotes: " + str.tostring(shortVotes) + "\nAdaptive min: " + str.tostring(adaptiveMinScore, "#") + "\nChop/Unc: " + str.tostring(chopScore, "#") + " / " + str.tostring(uncertainty, "#") + "\nGreen guard: " + (equityCaution or drawdownCaution ? "caution" : "normal")

if longSignal
    activeStop := longStop
    activeTarget := longTarget
    activeRisk := longRisk
    activeBest := high
    activeEntryBar := bar_index
    activeSetup := longSetup
    tradesToday += 1
    lastTradeBar := bar_index
    strategy.entry("Quantum Long", strategy.long, qty=actualQty, alert_message=longMsg)
    strategy.exit("Quantum Long Risk", from_entry="Quantum Long", stop=activeStop, limit=activeTarget, alert_message=exitLongMsg)
    alert(longMsg, alert.freq_once_per_bar_close)
    if showLabels
        label.new(bar_index, low, "Q BUY\n" + longSetup, style=label.style_label_up, color=color.new(color.lime, 0), textcolor=color.black, size=size.small, tooltip=longTooltip)

if shortSignal
    activeStop := shortStop
    activeTarget := shortTarget
    activeRisk := shortRisk
    activeBest := low
    activeEntryBar := bar_index
    activeSetup := shortSetup
    tradesToday += 1
    lastTradeBar := bar_index
    strategy.entry("Quantum Short", strategy.short, qty=actualQty, alert_message=shortMsg)
    strategy.exit("Quantum Short Risk", from_entry="Quantum Short", stop=activeStop, limit=activeTarget, alert_message=exitShortMsg)
    alert(shortMsg, alert.freq_once_per_bar_close)
    if showLabels
        label.new(bar_index, high, "Q SELL\n" + shortSetup, style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.small, tooltip=shortTooltip)

if strategy.position_size > 0 and not na(activeStop)
    activeBest := math.max(nz(activeBest, high), high)
    openR = (close - strategy.position_avg_price) / math.max(activeRisk, syminfo.mintick)
    bestR = (activeBest - strategy.position_avg_price) / math.max(activeRisk, syminfo.mintick)
    if openR >= trailAfterR
        structureTrail = math.max(activeBest - atr * trailAtrMult, priorLow - syminfo.mintick * 2.0)
        profitLockStop = strategy.position_avg_price + activeRisk * (bestR >= 1.30 ? 0.45 : bestR >= 0.85 ? 0.18 : 0.05)
        activeStop := math.max(activeStop, structureTrail, profitLockStop)
    strategy.exit("Quantum Long Risk", from_entry="Quantum Long", stop=activeStop, limit=activeTarget, alert_message=exitLongMsg)

if strategy.position_size < 0 and not na(activeStop)
    activeBest := math.min(nz(activeBest, low), low)
    openR = (strategy.position_avg_price - close) / math.max(activeRisk, syminfo.mintick)
    bestR = (strategy.position_avg_price - activeBest) / math.max(activeRisk, syminfo.mintick)
    if openR >= trailAfterR
        structureTrail = math.min(activeBest + atr * trailAtrMult, priorHigh + syminfo.mintick * 2.0)
        profitLockStop = strategy.position_avg_price - activeRisk * (bestR >= 1.30 ? 0.45 : bestR >= 0.85 ? 0.18 : 0.05)
        activeStop := math.min(activeStop, structureTrail, profitLockStop)
    strategy.exit("Quantum Short Risk", from_entry="Quantum Short", stop=activeStop, limit=activeTarget, alert_message=exitShortMsg)

barsInTrade = strategy.position_size != 0 and not na(activeEntryBar) ? bar_index - activeEntryBar : 0
longOpenR = strategy.position_size > 0 ? (close - strategy.position_avg_price) / math.max(activeRisk, syminfo.mintick) : 0.0
shortOpenR = strategy.position_size < 0 ? (strategy.position_avg_price - close) / math.max(activeRisk, syminfo.mintick) : 0.0
longBestR = strategy.position_size > 0 and not na(activeBest) ? (activeBest - strategy.position_avg_price) / math.max(activeRisk, syminfo.mintick) : 0.0
shortBestR = strategy.position_size < 0 and not na(activeBest) ? (strategy.position_avg_price - activeBest) / math.max(activeRisk, syminfo.mintick) : 0.0
longGivebackR = math.max(longBestR - longOpenR, 0.0)
shortGivebackR = math.max(shortBestR - shortOpenR, 0.0)

sessionExit = useSessionFilter and strategy.position_size != 0 and not inSession
longAdverseExit = strategy.position_size > 0 and longOpenR <= -earlyAdverseR and (shortScore > longScore or close < vwapValue or closeNearLow)
shortAdverseExit = strategy.position_size < 0 and shortOpenR <= -earlyAdverseR and (longScore > shortScore or close > vwapValue or closeNearHigh)
longGivebackExit = strategy.position_size > 0 and longBestR >= 0.55 and longGivebackR >= profitGivebackR and (longScore - shortScore < 8 or closeNearLow)
shortGivebackExit = strategy.position_size < 0 and shortBestR >= 0.55 and shortGivebackR >= profitGivebackR and (shortScore - longScore < 8 or closeNearHigh)
longNoFollow = strategy.position_size > 0 and barsInTrade >= 2 and longOpenR < 0.15 and longScore < shortScore + 8
shortNoFollow = strategy.position_size < 0 and barsInTrade >= 2 and shortOpenR < 0.15 and shortScore < longScore + 8
longWeakTime = strategy.position_size > 0 and barsInTrade >= maxBarsInTrade and (longScore < shortScore + 8 or not trendClarityLong)
shortWeakTime = strategy.position_size < 0 and barsInTrade >= maxBarsInTrade and (shortScore < longScore + 8 or not trendClarityShort)
longThesis = strategy.position_size > 0 and ((close < emaPullback and close < vwapValue) or shortScore > longScore + 8 or (closeNearLow and relativeVolume >= 0.9))
shortThesis = strategy.position_size < 0 and ((close > emaPullback and close > vwapValue) or longScore > shortScore + 8 or (closeNearHigh and relativeVolume >= 0.9))
exitLong = confirmedOk and strategy.position_size > 0 and (sessionExit or longAdverseExit or longGivebackExit or longNoFollow or longWeakTime or longThesis)
exitShort = confirmedOk and strategy.position_size < 0 and (sessionExit or shortAdverseExit or shortGivebackExit or shortNoFollow or shortWeakTime or shortThesis)

if exitLong
    strategy.close("Quantum Long", alert_message=exitLongMsg)
    lastTradeBar := bar_index

if exitShort
    strategy.close("Quantum Short", alert_message=exitShortMsg)
    lastTradeBar := bar_index

if strategy.position_size == 0 and not longSignal and not shortSignal
    activeStop := na
    activeTarget := na
    activeRisk := na
    activeBest := na
    activeEntryBar := na

// ---------------- Visuals ----------------
plot(showKeyLevels ? vwapValue : na, "VWAP", color=color.new(color.white, 0), linewidth=2)
plot(showKeyLevels ? emaPullback : na, "EMA 21", color=color.new(color.blue, 0))
plot(showKeyLevels ? emaFast : na, "EMA 50", color=color.new(color.orange, 0))
plot(showKeyLevels ? emaSlow : na, "EMA 200", color=color.new(color.fuchsia, 10), linewidth=2)
plot(showKeyLevels ? priorHigh : na, "Prior 20 High", color=color.new(color.red, 75), style=plot.style_linebr)
plot(showKeyLevels ? priorLow : na, "Prior 20 Low", color=color.new(color.lime, 75), style=plot.style_linebr)
plotshape(longSignal, "Quantum Long", shape.labelup, location.belowbar, color.new(color.lime, 0), text="Q BUY", textcolor=color.black, size=size.small)
plotshape(shortSignal, "Quantum Short", shape.labeldown, location.abovebar, color.new(color.red, 0), text="Q SELL", textcolor=color.white, size=size.small)
plotshape(exitLong, "Quantum Exit Long", shape.xcross, location.abovebar, color.new(color.yellow, 0), text="XL", textcolor=color.black, size=size.tiny)
plotshape(exitShort, "Quantum Exit Short", shape.xcross, location.belowbar, color.new(color.yellow, 0), text="XS", textcolor=color.black, size=size.tiny)

var line entryLine = na
var line stopLine = na
var line targetLine = na
if showLines and (longSignal or shortSignal)
    if not na(entryLine)
        line.delete(entryLine)
    if not na(stopLine)
        line.delete(stopLine)
    if not na(targetLine)
        line.delete(targetLine)
    entryLine := line.new(bar_index, close, bar_index + 30, close, color=color.new(color.white, 10), width=1)
    stopLine := line.new(bar_index, longSignal ? longStop : shortStop, bar_index + 30, longSignal ? longStop : shortStop, color=color.new(color.red, 0), width=2)
    targetLine := line.new(bar_index, longSignal ? longTarget : shortTarget, bar_index + 30, longSignal ? longTarget : shortTarget, color=color.new(color.lime, 0), width=2)
if showLines and not na(entryLine)
    line.set_x2(entryLine, bar_index + 30)
    line.set_x2(stopLine, bar_index + 30)
    line.set_x2(targetLine, bar_index + 30)
    if not na(activeStop)
        line.set_y1(stopLine, activeStop)
        line.set_y2(stopLine, activeStop)
    if not na(activeTarget)
        line.set_y1(targetLine, activeTarget)
        line.set_y2(targetLine, activeTarget)

status = not symbolOk ? "NQ only" : not windowOk ? "Before 4Y window" : not inSession ? "Session wait" : dailyLossLock ? "Daily lock" : lossLock ? "Loss lock" : greenLineLock ? "Profit protected" : tradeCountLock ? "Trade lock" : equityCaution or drawdownCaution ? "A+ only" : chopScore > adaptiveMaxChop ? "Chop wait" : longSignal ? "Long fired" : shortSignal ? "Short fired" : "Scanning"
var table dash = table.new(position.bottom_right, 2, 12, bgcolor=color.new(color.black, 18), border_color=color.new(color.white, 75), border_width=1)
if showDashboard and barstate.islast
    table.cell(dash, 0, 0, "NQ Sync", text_color=color.white, bgcolor=color.new(color.teal, 55), text_size=size.tiny)
    table.cell(dash, 1, 0, status, text_color=color.white, bgcolor=color.new(color.teal, 55), text_size=size.tiny)
    table.cell(dash, 0, 1, "Score", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 1, str.tostring(longScore, "#") + " / " + str.tostring(shortScore, "#"), text_color=longScore >= shortScore ? color.lime : color.orange, text_size=size.tiny)
    table.cell(dash, 0, 2, "Votes", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 2, str.tostring(longVotes) + " / " + str.tostring(shortVotes), text_color=longVotes >= shortVotes ? color.lime : color.orange, text_size=size.tiny)
    table.cell(dash, 0, 3, "Chop/Unc", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 3, str.tostring(chopScore, "#") + " / " + str.tostring(uncertainty, "#"), text_color=chopScore <= maxChopScore and uncertainty <= maxUncertainty ? color.lime : color.orange, text_size=size.tiny)
    table.cell(dash, 0, 4, "Setup", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 4, activeSetup, text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 5, "Day", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 5, str.tostring(tradesToday) + " W" + str.tostring(winsToday) + " L" + str.tostring(lossesToday), text_color=lossLock ? color.red : color.white, text_size=size.tiny)
    table.cell(dash, 0, 6, "P/L", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 6, str.tostring(dailyPnl, "#.##"), text_color=dailyPnl >= 0 ? color.lime : color.red, text_size=size.tiny)
    table.cell(dash, 0, 7, "HTF", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 7, htfBull ? "Bull" : htfBear ? "Bear" : "Mixed", text_color=htfBull ? color.lime : htfBear ? color.orange : color.silver, text_size=size.tiny)
    table.cell(dash, 0, 8, "Kauf", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 8, str.tostring(kaufmanRatio, "#.##"), text_color=kaufmanRatio >= minKaufmanRatio ? color.lime : color.silver, text_size=size.tiny)
    table.cell(dash, 0, 9, "RVOL", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 9, str.tostring(relativeVolume, "#.##"), text_color=volumeOk ? color.lime : color.orange, text_size=size.tiny)
    table.cell(dash, 0, 10, "Backtest", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 10, str.tostring(rollingBacktestYears) + "Y Any TF", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 11, "NoLeak", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 11, "Bar close only", text_color=color.lime, text_size=size.tiny)

alertcondition(longSignal, "NQ Quantum Sync Long", "NQ Quantum Sync long fired. Use Any alert() function call or {{strategy.order.alert_message}}.")
alertcondition(shortSignal, "NQ Quantum Sync Short", "NQ Quantum Sync short fired. Use Any alert() function call or {{strategy.order.alert_message}}.")
alertcondition(exitLong, "NQ Quantum Sync Exit Long", "NQ Quantum Sync exit long.")
alertcondition(exitShort, "NQ Quantum Sync Exit Short", "NQ Quantum Sync exit short.")
