//@version=6
//@strategy_alert_message {{strategy.order.alert_message}}
strategy(title="Clean Buy Sell Strategy", shorttitle="Clean B/S", overlay=true, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0, margin_long=10, margin_short=10, process_orders_on_close=true, calc_on_every_tick=false, calc_on_order_fills=true, commission_type=strategy.commission.cash_per_contract, commission_value=4.00, slippage=2, max_labels_count=500, max_lines_count=500)

grpSignal = "Signal"
signalLen = input.int(30, "Signal Length", minval=2, maxval=1000, group=grpSignal)
slowMultiplier = input.float(2.2, "Trend Smoothness", minval=1.1, maxval=20.0, step=0.1, group=grpSignal)
signalSmooth = input.float(2.6, "Signal Smoothness", minval=0.1, maxval=50.0, step=0.1, group=grpSignal)
minBarsBetweenSignals = input.int(6, "Minimum Bars Between Signals", minval=0, group=grpSignal)
tradePreference = input.string("All Trades", "Trading Preference", options=["All Trades", "Only Buy Trades", "Only Sell Trades"], group=grpSignal)
exitMode = input.string("Managed ATR", "Exit Mode", options=["Managed ATR", "Signal Flip"], group=grpSignal)

grpFilters = "Filters"
useTrendFilter = input.bool(true, "Use 200 EMA Trend Filter", group=grpFilters)
trendLen = input.int(200, "Trend EMA Length", minval=5, group=grpFilters, active=useTrendFilter)
useRsiFilter = input.bool(true, "Use RSI Bias Filter", group=grpFilters)
rsiLen = input.int(14, "RSI Length", minval=2, group=grpFilters, active=useRsiFilter)
rsiBias = input.float(3.0, "RSI Bias", minval=0.0, maxval=30.0, step=0.5, group=grpFilters, active=useRsiFilter)
useAdxFilter = input.bool(true, "Use ADX Filter", group=grpFilters)
dmiLen = input.int(14, "DMI Length", minval=2, group=grpFilters, active=useAdxFilter)
adxSmooth = input.int(14, "ADX Smoothing", minval=1, group=grpFilters, active=useAdxFilter)
minAdx = input.float(14.0, "Minimum ADX", minval=1.0, step=0.5, group=grpFilters, active=useAdxFilter)

grpRisk = "Risk"
orderSize = input.float(1.0, "Order Size", minval=0.01, step=0.1, group=grpRisk)
atrLen = input.int(14, "ATR Length", minval=1, group=grpRisk)
stopAtr = input.float(1.5, "Stop ATR", minval=0.1, step=0.1, group=grpRisk)
rewardRisk = input.float(1.35, "Reward / Risk", minval=0.1, step=0.05, group=grpRisk)
useTrail = input.bool(true, "Trail Stop After Profit", group=grpRisk)
trailStartR = input.float(0.8, "Trail Starts At R", minval=0.1, step=0.1, group=grpRisk, active=useTrail)
trailAtr = input.float(1.1, "Trail ATR", minval=0.1, step=0.1, group=grpRisk, active=useTrail)
maxBarsInTrade = input.int(100, "Max Bars In Trade", minval=1, group=grpRisk)

grpSession = "Trading Session"
useSessionFilter = input.bool(false, "Enable Session Filter", group=grpSession)
sessionInput = input.session("0930-1600", "Session", group=grpSession, active=useSessionFilter)
closeOnSessionEnd = input.bool(true, "Close At Session End", group=grpSession, active=useSessionFilter)
showSessionBg = input.bool(true, "Highlight Closed Session", group=grpSession, active=useSessionFilter)

grpVisual = "Visuals"
showLabels = input.bool(true, "Show Entry / Exit Labels", group=grpVisual)
showLevels = input.bool(true, "Show Stop / Target Lines", group=grpVisual)
colorCandles = input.bool(true, "Color Candles By Signal", group=grpVisual)
showDashboard = input.bool(true, "Show Dashboard", group=grpVisual)

grpAlerts = "Alerts"
longEntryAlert = input.string("Buy", "Long Entry Alert", group=grpAlerts)
shortEntryAlert = input.string("Sell", "Short Entry Alert", group=grpAlerts)
longExitAlert = input.string("Exit Long", "Long Exit Alert", group=grpAlerts)
shortExitAlert = input.string("Exit Short", "Short Exit Alert", group=grpAlerts)

colBuy = color.rgb(255, 223, 0)
colSell = color.rgb(255, 57, 4)
colProfit = color.rgb(0, 200, 2)
colLoss = color.rgb(255, 57, 4)
colPanel = color.rgb(13, 15, 20)
colHeader = color.rgb(19, 2, 50)

inSession = not useSessionFilter or not na(time(timeframe.period, sessionInput))
sessionEnded = useSessionFilter and closeOnSessionEnd and inSession[1] and not inSession
allowLongs = tradePreference == "All Trades" or tradePreference == "Only Buy Trades"
allowShorts = tradePreference == "All Trades" or tradePreference == "Only Sell Trades"

fastLen = math.max(2, signalLen)
slowLen = math.max(fastLen + 1, int(math.round(signalLen * slowMultiplier)))
sigLen = math.max(1, int(math.round(signalLen * signalSmooth)))

fastEma = ta.ema(close, fastLen)
slowEma = ta.ema(close, slowLen)
rawSignal = fastEma - slowEma
signalLine = ta.ema(rawSignal, sigLen)
trendEma = ta.ema(close, trendLen)
rsi = ta.rsi(close, rsiLen)
[plusDi, minusDi, adx] = ta.dmi(dmiLen, adxSmooth)
atrRaw = ta.atr(atrLen)
atr = math.max(nz(atrRaw, syminfo.mintick), syminfo.mintick)

rawFlipUp = ta.crossover(rawSignal, signalLine)
rawFlipDown = ta.crossunder(rawSignal, signalLine)
trendLongOk = not useTrendFilter or close > trendEma
trendShortOk = not useTrendFilter or close < trendEma
rsiLongOk = not useRsiFilter or rsi > 50.0 + rsiBias
rsiShortOk = not useRsiFilter or rsi < 50.0 - rsiBias
adxLongOk = not useAdxFilter or (adx >= minAdx and plusDi > minusDi)
adxShortOk = not useAdxFilter or (adx >= minAdx and minusDi > plusDi)

var int lastSignalBar = na
cooldownOk = na(lastSignalBar) or bar_index - lastSignalBar >= minBarsBetweenSignals
confirmed = barstate.isconfirmed
longCandidate = confirmed and inSession and allowLongs and cooldownOk and rawFlipUp and trendLongOk and rsiLongOk and adxLongOk
shortCandidate = confirmed and inSession and allowShorts and cooldownOk and rawFlipDown and trendShortOk and rsiShortOk and adxShortOk

flat = strategy.position_size == 0
longOpen = strategy.position_size > 0
shortOpen = strategy.position_size < 0
managedMode = exitMode == "Managed ATR"
flipMode = exitMode == "Signal Flip"

var float activeStop = na
var float activeTarget = na
var float entryRisk = na
var int entryBar = na
var line stopLine = na
var line targetLine = na

if longCandidate and (flat or (flipMode and shortOpen))
    if shortOpen
        strategy.close("Short", comment="Signal Flip", alert_message=shortExitAlert)
    activeStop := close - stopAtr * atr
    entryRisk := close - activeStop
    activeTarget := close + entryRisk * rewardRisk
    if not na(stopLine)
        line.delete(stopLine)
    if not na(targetLine)
        line.delete(targetLine)
    stopLine := na
    targetLine := na
    if showLevels and managedMode
        stopLine := line.new(bar_index, activeStop, bar_index + 1, activeStop, extend=extend.right, color=color.new(colLoss, 0), width=1)
        targetLine := line.new(bar_index, activeTarget, bar_index + 1, activeTarget, extend=extend.right, color=color.new(colProfit, 0), width=1)
    strategy.entry("Long", strategy.long, qty=orderSize, alert_message=longEntryAlert)
    if showLabels
        label.new(bar_index, low - atr * 0.25, "BUY", style=label.style_label_up, color=colBuy, textcolor=color.black, size=size.small)
    lastSignalBar := bar_index
    entryBar := bar_index

if shortCandidate and (flat or (flipMode and longOpen))
    if longOpen
        strategy.close("Long", comment="Signal Flip", alert_message=longExitAlert)
    activeStop := close + stopAtr * atr
    entryRisk := activeStop - close
    activeTarget := close - entryRisk * rewardRisk
    if not na(stopLine)
        line.delete(stopLine)
    if not na(targetLine)
        line.delete(targetLine)
    stopLine := na
    targetLine := na
    if showLevels and managedMode
        stopLine := line.new(bar_index, activeStop, bar_index + 1, activeStop, extend=extend.right, color=color.new(colLoss, 0), width=1)
        targetLine := line.new(bar_index, activeTarget, bar_index + 1, activeTarget, extend=extend.right, color=color.new(colProfit, 0), width=1)
    strategy.entry("Short", strategy.short, qty=orderSize, alert_message=shortEntryAlert)
    if showLabels
        label.new(bar_index, high + atr * 0.25, "SELL", style=label.style_label_down, color=colSell, textcolor=color.white, size=size.small)
    lastSignalBar := bar_index
    entryBar := bar_index

barsInTrade = na(entryBar) ? 0 : bar_index - entryBar
oppositeLongExit = managedMode and longOpen and rawFlipDown
oppositeShortExit = managedMode and shortOpen and rawFlipUp
durationExit = barsInTrade >= maxBarsInTrade

if managedMode and longOpen
    if useTrail and close - strategy.position_avg_price >= nz(entryRisk, atr) * trailStartR
        activeStop := math.max(activeStop, close - trailAtr * atr)
        if showLevels and not na(stopLine)
            line.set_y1(stopLine, activeStop)
            line.set_y2(stopLine, activeStop)
    strategy.exit("Long Risk Exit", from_entry="Long", stop=activeStop, limit=activeTarget, alert_message=longExitAlert)

if managedMode and shortOpen
    if useTrail and strategy.position_avg_price - close >= nz(entryRisk, atr) * trailStartR
        activeStop := math.min(activeStop, close + trailAtr * atr)
        if showLevels and not na(stopLine)
            line.set_y1(stopLine, activeStop)
            line.set_y2(stopLine, activeStop)
    strategy.exit("Short Risk Exit", from_entry="Short", stop=activeStop, limit=activeTarget, alert_message=shortExitAlert)

closeLongNow = confirmed and longOpen and (oppositeLongExit or durationExit or sessionEnded)
closeShortNow = confirmed and shortOpen and (oppositeShortExit or durationExit or sessionEnded)

if closeLongNow
    reason = sessionEnded ? "Session End" : durationExit ? "Duration Exit" : "Signal Exit"
    strategy.close("Long", comment=reason, alert_message=longExitAlert)
    if showLabels
        label.new(bar_index, close, close >= strategy.position_avg_price ? "Profit" : "Loss", style=label.style_label_center, color=close >= strategy.position_avg_price ? colProfit : colLoss, textcolor=color.white, size=size.tiny)
    activeStop := na
    activeTarget := na
    entryRisk := na
    entryBar := na

if closeShortNow
    reason = sessionEnded ? "Session End" : durationExit ? "Duration Exit" : "Signal Exit"
    strategy.close("Short", comment=reason, alert_message=shortExitAlert)
    if showLabels
        label.new(bar_index, close, close <= strategy.position_avg_price ? "Profit" : "Loss", style=label.style_label_center, color=close <= strategy.position_avg_price ? colProfit : colLoss, textcolor=color.white, size=size.tiny)
    activeStop := na
    activeTarget := na
    entryRisk := na
    entryBar := na

if flat and not longCandidate and not shortCandidate
    activeStop := na
    activeTarget := na
    entryRisk := na
    entryBar := na

biasColor = rawSignal > signalLine ? color.new(colProfit, 0) : rawSignal < signalLine ? color.new(colLoss, 0) : na
plotcandle(colorCandles ? open : na, colorCandles ? high : na, colorCandles ? low : na, colorCandles ? close : na, title="Signal Candle Color", color=biasColor, wickcolor=biasColor, bordercolor=biasColor, display=display.pane)
plot(fastEma, "Fast EMA", color=color.new(color.yellow, 15))
plot(slowEma, "Slow EMA", color=color.new(color.white, 35))
plot(useTrendFilter ? trendEma : na, "Trend EMA", color=color.new(color.aqua, 35))
bgcolor(useSessionFilter and showSessionBg and not inSession ? color.new(colLoss, 92) : na, title="Closed Session")

alertcondition(longCandidate, "Buy Signal", "Clean Buy Sell buy signal")
alertcondition(shortCandidate, "Sell Signal", "Clean Buy Sell sell signal")
alertcondition(closeLongNow, "Long Exit", "Clean Buy Sell long exit")
alertcondition(closeShortNow, "Short Exit", "Clean Buy Sell short exit")

var table dashboard = table.new(position.bottom_right, 2, 8, border_width=1)
if showDashboard and barstate.islast
    winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100.0 : na
    pf = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na
    posText = longOpen ? "Long" : shortOpen ? "Short" : "Flat"
    modeText = managedMode ? "Managed" : "Flip"
    table.clear(dashboard, 0, 0, 1, 7)
    table.cell(dashboard, 0, 0, "Clean B/S", bgcolor=colHeader, text_color=color.white, text_size=size.small)
    table.cell(dashboard, 1, 0, modeText, bgcolor=colHeader, text_color=color.white, text_size=size.small)
    table.cell(dashboard, 0, 1, "Position", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 1, posText, bgcolor=colPanel, text_color=color.white, text_size=size.tiny)
    table.cell(dashboard, 0, 2, "Net Profit", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 2, str.tostring(strategy.netprofit, format.mintick), bgcolor=colPanel, text_color=strategy.netprofit >= 0 ? colProfit : colLoss, text_size=size.tiny)
    table.cell(dashboard, 0, 3, "Closed Trades", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 3, str.tostring(strategy.closedtrades), bgcolor=colPanel, text_color=color.white, text_size=size.tiny)
    table.cell(dashboard, 0, 4, "Win Rate", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 4, na(winRate) ? "-" : str.tostring(winRate, "0.0") + "%", bgcolor=colPanel, text_color=color.white, text_size=size.tiny)
    table.cell(dashboard, 0, 5, "Profit Factor", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 5, na(pf) ? "-" : str.tostring(pf, "0.00"), bgcolor=colPanel, text_color=color.white, text_size=size.tiny)
    table.cell(dashboard, 0, 6, "ADX", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 6, str.tostring(adx, "0.0"), bgcolor=colPanel, text_color=color.white, text_size=size.tiny)
    table.cell(dashboard, 0, 7, "Session", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 7, inSession ? "Open" : "Closed", bgcolor=colPanel, text_color=inSession ? colProfit : colLoss, text_size=size.tiny)
