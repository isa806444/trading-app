//@version=6
//@strategy_alert_message {{strategy.order.alert_message}}
strategy(title="Clean High Win Rate Strategy", shorttitle="Clean HWR", overlay=true, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0, margin_long=10, margin_short=10, process_orders_on_close=true, calc_on_every_tick=false, calc_on_order_fills=true, commission_type=strategy.commission.cash_per_contract, commission_value=4.00, slippage=2, max_labels_count=500, max_lines_count=500)

grpSignal = "Signal"
fastLen = input.int(21, "Fast EMA", minval=1, group=grpSignal)
slowLen = input.int(55, "Slow EMA", minval=2, group=grpSignal)
rsiLen = input.int(14, "RSI Length", minval=2, group=grpSignal)
rsiBull = input.float(53.0, "RSI Long Bias", minval=1.0, maxval=99.0, step=0.5, group=grpSignal)
rsiBear = input.float(47.0, "RSI Short Bias", minval=1.0, maxval=99.0, step=0.5, group=grpSignal)
adxLen = input.int(14, "DMI Length", minval=2, group=grpSignal)
adxSmooth = input.int(14, "ADX Smoothing", minval=1, group=grpSignal)
minAdx = input.float(15.0, "Minimum ADX", minval=1.0, step=0.5, group=grpSignal)
macdFast = input.int(12, "MACD Fast", minval=1, group=grpSignal)
macdSlow = input.int(26, "MACD Slow", minval=2, group=grpSignal)
macdSignalLen = input.int(9, "MACD Signal", minval=1, group=grpSignal)
minScore = input.int(6, "Entry Score Needed", minval=3, maxval=8, group=grpSignal)
scoreEdge = input.int(2, "Minimum Score Edge", minval=0, maxval=8, group=grpSignal)
cooldownBars = input.int(8, "Minimum Bars Between Entries", minval=0, group=grpSignal)
tradePreference = input.string("All Trades", "Trading Preference", options=["All Trades", "Only Long", "Only Short"], group=grpSignal)

grpRisk = "Risk"
contracts = input.float(1.0, "Order Size", minval=0.0, step=0.1, group=grpRisk)
useStops = input.bool(true, "Use ATR Stop And Target", group=grpRisk)
atrLen = input.int(14, "ATR Length", minval=1, group=grpRisk)
stopAtr = input.float(1.6, "Stop ATR", minval=0.1, step=0.1, group=grpRisk)
rewardRisk = input.float(1.15, "Reward / Risk", minval=0.1, step=0.05, group=grpRisk)
useTrail = input.bool(true, "Trail Stop After Profit", group=grpRisk)
trailStartR = input.float(0.8, "Trail Starts At R", minval=0.1, step=0.1, group=grpRisk)
trailAtr = input.float(1.1, "Trail ATR", minval=0.1, step=0.1, group=grpRisk)
maxBarsInTrade = input.int(80, "Max Bars In Trade", minval=1, group=grpRisk)
pureSignalMode = input.bool(false, "Pure Signal Flip Mode", group=grpRisk)

grpSession = "Trading Session"
useSessionFilter = input.bool(false, "Enable Session Filter", group=grpSession)
sessionInput = input.session("0930-1600", "Session", group=grpSession, active=useSessionFilter)
closeOnSessionEnd = input.bool(true, "Close At Session End", group=grpSession, active=useSessionFilter)
showSessionBg = input.bool(true, "Highlight Closed Session", group=grpSession, active=useSessionFilter)

grpVisual = "Visuals"
showLabels = input.bool(true, "Show Entry / Exit Labels", group=grpVisual)
showLevels = input.bool(true, "Show Stop / Target Lines", group=grpVisual)
colorCandles = input.bool(true, "Color Candles By Bias", group=grpVisual)
showDashboard = input.bool(true, "Show Dashboard", group=grpVisual)

colLong = color.rgb(255, 223, 0)
colShort = color.rgb(255, 57, 4)
colProfit = color.rgb(0, 200, 2)
colLoss = color.rgb(255, 57, 4)
colPanel = color.rgb(13, 15, 20)
colHeader = color.rgb(19, 2, 50)

inSession = not useSessionFilter or not na(time(timeframe.period, sessionInput))
sessionEnded = useSessionFilter and closeOnSessionEnd and inSession[1] and not inSession
allowLongs = tradePreference == "All Trades" or tradePreference == "Only Long"
allowShorts = tradePreference == "All Trades" or tradePreference == "Only Short"

emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
rsi = ta.rsi(close, rsiLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignalLen)
[plusDi, minusDi, adx] = ta.dmi(adxLen, adxSmooth)
atrRaw = ta.atr(atrLen)
atr = math.max(nz(atrRaw, syminfo.mintick), syminfo.mintick)

trendUp = emaFast > emaSlow and close > emaFast
trendDown = emaFast < emaSlow and close < emaFast
momentumUp = macdLine > macdSignal and macdHist > macdHist[1]
momentumDown = macdLine < macdSignal and macdHist < macdHist[1]
rsiUp = rsi >= rsiBull
rsiDown = rsi <= rsiBear
dmiUp = adx >= minAdx and plusDi > minusDi
dmiDown = adx >= minAdx and minusDi > plusDi
priceUp = close > high[1] or (close > open and close > close[1])
priceDown = close < low[1] or (close < open and close < close[1])

longScore = (trendUp ? 2 : 0) + (momentumUp ? 2 : 0) + (rsiUp ? 1 : 0) + (dmiUp ? 2 : 0) + (priceUp ? 1 : 0)
shortScore = (trendDown ? 2 : 0) + (momentumDown ? 2 : 0) + (rsiDown ? 1 : 0) + (dmiDown ? 2 : 0) + (priceDown ? 1 : 0)

scoreDelta = longScore - shortScore
longSetup = longScore >= minScore and scoreDelta >= scoreEdge
shortSetup = shortScore >= minScore and scoreDelta <= -scoreEdge

var int lastEntryBar = na
var int entryBar = na
cooldownOk = na(lastEntryBar) or bar_index - lastEntryBar >= cooldownBars
confirmed = barstate.isconfirmed
flat = strategy.position_size == 0

longSignal = confirmed and inSession and flat and allowLongs and cooldownOk and longSetup and longSetup[1] != true
shortSignal = confirmed and inSession and flat and allowShorts and cooldownOk and shortSetup and shortSetup[1] != true

var float activeStop = na
var float activeTarget = na
var float entryRisk = na
var line stopLine = na
var line targetLine = na

if longSignal
    activeStop := close - stopAtr * atr
    entryRisk := close - activeStop
    activeTarget := close + entryRisk * rewardRisk
    if not na(stopLine)
        line.delete(stopLine)
    if not na(targetLine)
        line.delete(targetLine)
    stopLine := na
    targetLine := na
    if showLevels and useStops
        stopLine := line.new(bar_index, activeStop, bar_index + 1, activeStop, extend=extend.right, color=color.new(colLoss, 0), width=1)
        targetLine := line.new(bar_index, activeTarget, bar_index + 1, activeTarget, extend=extend.right, color=color.new(colProfit, 0), width=1)
    strategy.entry("Long", strategy.long, qty=contracts, alert_message="Long Entry")
    if showLabels
        label.new(bar_index, low - atr * 0.25, "BUY", style=label.style_label_up, color=colLong, textcolor=color.black, size=size.small)
    lastEntryBar := bar_index
    entryBar := bar_index

if shortSignal
    activeStop := close + stopAtr * atr
    entryRisk := activeStop - close
    activeTarget := close - entryRisk * rewardRisk
    if not na(stopLine)
        line.delete(stopLine)
    if not na(targetLine)
        line.delete(targetLine)
    stopLine := na
    targetLine := na
    if showLevels and useStops
        stopLine := line.new(bar_index, activeStop, bar_index + 1, activeStop, extend=extend.right, color=color.new(colLoss, 0), width=1)
        targetLine := line.new(bar_index, activeTarget, bar_index + 1, activeTarget, extend=extend.right, color=color.new(colProfit, 0), width=1)
    strategy.entry("Short", strategy.short, qty=contracts, alert_message="Short Entry")
    if showLabels
        label.new(bar_index, high + atr * 0.25, "SELL", style=label.style_label_down, color=colShort, textcolor=color.white, size=size.small)
    lastEntryBar := bar_index
    entryBar := bar_index

longOpen = strategy.position_size > 0
shortOpen = strategy.position_size < 0
barsInTrade = na(entryBar) ? 0 : bar_index - entryBar

if longOpen and useStops
    if useTrail and close - strategy.position_avg_price >= nz(entryRisk, atr) * trailStartR
        activeStop := math.max(activeStop, close - trailAtr * atr)
        if showLevels and not na(stopLine)
            line.set_y1(stopLine, activeStop)
            line.set_y2(stopLine, activeStop)
    strategy.exit("Long Risk Exit", from_entry="Long", stop=activeStop, limit=activeTarget, alert_message="Long Exit")

if shortOpen and useStops
    if useTrail and strategy.position_avg_price - close >= nz(entryRisk, atr) * trailStartR
        activeStop := math.min(activeStop, close + trailAtr * atr)
        if showLevels and not na(stopLine)
            line.set_y1(stopLine, activeStop)
            line.set_y2(stopLine, activeStop)
    strategy.exit("Short Risk Exit", from_entry="Short", stop=activeStop, limit=activeTarget, alert_message="Short Exit")

exitLongSignal = confirmed and longOpen and ((pureSignalMode and shortSetup) or barsInTrade >= maxBarsInTrade or sessionEnded)
exitShortSignal = confirmed and shortOpen and ((pureSignalMode and longSetup) or barsInTrade >= maxBarsInTrade or sessionEnded)

if exitLongSignal
    strategy.close("Long", comment=sessionEnded ? "Session End" : barsInTrade >= maxBarsInTrade ? "Duration Exit" : "Signal Flip", alert_message="Long Close")
    if showLabels
        label.new(bar_index, close, close >= strategy.position_avg_price ? "Profit" : "Loss", style=label.style_label_center, color=close >= strategy.position_avg_price ? colProfit : colLoss, textcolor=color.white, size=size.tiny)
    activeStop := na
    activeTarget := na
    entryRisk := na
    entryBar := na

if exitShortSignal
    strategy.close("Short", comment=sessionEnded ? "Session End" : barsInTrade >= maxBarsInTrade ? "Duration Exit" : "Signal Flip", alert_message="Short Close")
    if showLabels
        label.new(bar_index, close, close <= strategy.position_avg_price ? "Profit" : "Loss", style=label.style_label_center, color=close <= strategy.position_avg_price ? colProfit : colLoss, textcolor=color.white, size=size.tiny)
    activeStop := na
    activeTarget := na
    entryRisk := na
    entryBar := na

if flat and not longSignal and not shortSignal
    activeStop := na
    activeTarget := na
    entryRisk := na
    entryBar := na

biasColor = scoreDelta > 0 ? color.new(colProfit, 0) : scoreDelta < 0 ? color.new(colLoss, 0) : na
plotcandle(colorCandles ? open : na, colorCandles ? high : na, colorCandles ? low : na, colorCandles ? close : na, title="Bias Candle Color", color=biasColor, wickcolor=biasColor, bordercolor=biasColor, display=display.pane)
plot(emaFast, "Fast EMA", color=color.new(color.yellow, 15))
plot(emaSlow, "Slow EMA", color=color.new(color.white, 35))
bgcolor(useSessionFilter and showSessionBg and not inSession ? color.new(colLoss, 92) : na, title="Closed Session")

alertcondition(longSignal, "Long Entry", "Clean HWR long entry")
alertcondition(shortSignal, "Short Entry", "Clean HWR short entry")
alertcondition(exitLongSignal, "Long Close", "Clean HWR long close")
alertcondition(exitShortSignal, "Short Close", "Clean HWR short close")

var table dashboard = table.new(position.bottom_right, 2, 8, border_width=1)
if showDashboard and barstate.islast
    winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100.0 : na
    pf = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na
    posText = longOpen ? "Long" : shortOpen ? "Short" : "Flat"
    scoreText = str.tostring(longScore) + " / " + str.tostring(shortScore)
    table.clear(dashboard, 0, 0, 1, 7)
    table.cell(dashboard, 0, 0, "Clean HWR", bgcolor=colHeader, text_color=color.white, text_size=size.small)
    table.cell(dashboard, 1, 0, posText, bgcolor=colHeader, text_color=color.white, text_size=size.small)
    table.cell(dashboard, 0, 1, "Score L/S", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 1, scoreText, bgcolor=colPanel, text_color=color.white, text_size=size.tiny)
    table.cell(dashboard, 0, 2, "Net Profit", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 2, str.tostring(strategy.netprofit, format.mintick), bgcolor=colPanel, text_color=strategy.netprofit >= 0 ? colProfit : colLoss, text_size=size.tiny)
    table.cell(dashboard, 0, 3, "Closed Trades", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 3, str.tostring(strategy.closedtrades), bgcolor=colPanel, text_color=color.white, text_size=size.tiny)
    table.cell(dashboard, 0, 4, "Win Rate", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 4, na(winRate) ? "-" : str.tostring(winRate, "0.0") + "%", bgcolor=colPanel, text_color=color.white, text_size=size.tiny)
    table.cell(dashboard, 0, 5, "Profit Factor", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 5, na(pf) ? "-" : str.tostring(pf, "0.00"), bgcolor=colPanel, text_color=color.white, text_size=size.tiny)
    table.cell(dashboard, 0, 6, "ADX", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 6, str.tostring(adx, "0.0"), bgcolor=colPanel, text_color=color.white, text_size=size.tiny)
    table.cell(dashboard, 0, 7, "Session", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 7, inSession ? "Open" : "Closed", bgcolor=colPanel, text_color=inSession ? colProfit : colLoss, text_size=size.tiny)
