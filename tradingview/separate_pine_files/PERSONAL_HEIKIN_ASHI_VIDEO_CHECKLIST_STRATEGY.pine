//@version=6
//@strategy_alert_message {{strategy.order.alert_message}}
strategy("Personal Heikin Ashi Video Checklist Strategy", shorttitle="HA Video Checklist", overlay=true, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0, margin_long=10, margin_short=10, process_orders_on_close=true, calc_on_every_tick=false, calc_on_order_fills=true, commission_type=strategy.commission.cash_per_contract, commission_value=4.0, slippage=2, max_bars_back=500, max_labels_count=300, max_lines_count=160)

// Literal checklist version of the Heikin Ashi 100 EMA scalping setup:
// 1. Use 1m Heikin Ashi candles.
// 2. Trade only 10:00-12:00.
// 3. Longs only above the 100 EMA, shorts only below the 100 EMA.
// 4. Sit out when price is chopping around the EMA.
// 5. Wait for at least two clean flat-side pullback candles.
// 6. Enter on a high-range doji close, with the stop beyond the doji wick.

grpSetup = "Checklist Setup"
requireOneMinute = input.bool(true, "Require 1m Chart", group=grpSetup)
tradeSession = input.session("1000-1200", "Trade Window", group=grpSetup)
sessionTimezone = input.string("America/New_York", "Session Timezone", options=["America/New_York", "America/Chicago", "Etc/UTC"], group=grpSetup)
emaLen = input.int(100, "EMA Length", minval=5, maxval=500, group=grpSetup)
emaChopAtr = input.float(0.15, "EMA No-Trade Zone ATR", minval=0.0, maxval=2.0, step=0.01, group=grpSetup)
requireEmaSlope = input.bool(false, "Require EMA Slope Confirmation", group=grpSetup)
emaSlopeBars = input.int(5, "EMA Slope Bars", minval=1, maxval=50, group=grpSetup, active=requireEmaSlope)

grpPullback = "Pullback"
pullbackCandles = input.int(2, "Clean Pullback Candles Needed", minval=2, maxval=6, group=grpPullback)
flatToleranceTicks = input.int(1, "Flat Side Tolerance Ticks", minval=0, maxval=20, group=grpPullback)
requirePullbackProgress = input.bool(true, "Require Pullback Moves Against Trend", group=grpPullback)

grpDoji = "High-Range Doji"
maxBodyPct = input.float(0.28, "Max Body % Of Range", minval=0.01, maxval=0.80, step=0.01, group=grpDoji)
minWickPct = input.float(0.24, "Min Wick % Each Side", minval=0.01, maxval=0.70, step=0.01, group=grpDoji)
minWickBodyRatio = input.float(1.30, "Min Wick To Body Ratio", minval=0.1, maxval=10.0, step=0.1, group=grpDoji)
requireBiggerThanPrior = input.bool(true, "Doji Bigger Than Prior 1 Or 2", group=grpDoji)
useActualVolumeSpike = input.bool(false, "Also Require Volume Spike", group=grpDoji)
volumeLen = input.int(20, "Volume Average", minval=2, maxval=200, group=grpDoji, active=useActualVolumeSpike)
volumeMultiplier = input.float(1.15, "Volume Multiplier", minval=0.1, maxval=5.0, step=0.05, group=grpDoji, active=useActualVolumeSpike)

grpRisk = "Risk And Exits"
contracts = input.int(1, "Contracts", minval=1, maxval=20, group=grpRisk)
stopUses = input.string("Heikin Ashi Wick", "Stop Uses", options=["Heikin Ashi Wick", "Real Candle Wick"], group=grpRisk)
stopBufferTicks = input.int(2, "Stop Buffer Ticks", minval=0, maxval=50, group=grpRisk)
minRiskTicks = input.int(4, "Minimum Risk Ticks", minval=1, maxval=100, group=grpRisk)
maxRiskAtr = input.float(1.25, "Maximum Risk ATR", minval=0.1, maxval=5.0, step=0.05, group=grpRisk)
exitPlan = input.string("Scale 1R / 2R / Runner", "Exit Plan", options=["1R Only", "Scale 1R / 2R / Runner", "Full 3R Target"], group=grpRisk)
useStepStopLadder = input.bool(true, "Step Runner Stop By R", group=grpRisk, tooltip="At 2R move to breakeven. At 3R lock 2R. At 4R lock 3R, and so on.")
runnerBreakevenAtR = input.float(2.0, "Move Stop To Breakeven At R", minval=0.5, maxval=10.0, step=0.25, group=grpRisk)
maxBarsInTrade = input.int(15, "Max Bars In Trade", minval=1, maxval=60, group=grpRisk)
maxTradesPerDay = input.int(4, "Max Trades Per Day", minval=1, maxval=30, group=grpRisk)

grpVisual = "Visuals"
showLabels = input.bool(true, "Show Entry / Exit Labels", group=grpVisual)
showSetupMarkers = input.bool(true, "Show Checklist Markers", group=grpVisual)
showLevels = input.bool(true, "Show Stop / Target Lines", group=grpVisual)
colorCandles = input.bool(true, "Color Heikin Ashi Candles", group=grpVisual)
showDashboard = input.bool(true, "Show Checklist Dashboard", group=grpVisual)

grpAlerts = "Alerts"
longEntryAlert = input.string("HA Checklist Long", "Long Entry Alert", group=grpAlerts)
shortEntryAlert = input.string("HA Checklist Short", "Short Entry Alert", group=grpAlerts)
longExitAlert = input.string("HA Checklist Long Exit", "Long Exit Alert", group=grpAlerts)
shortExitAlert = input.string("HA Checklist Short Exit", "Short Exit Alert", group=grpAlerts)

colLong = color.rgb(0, 200, 2)
colShort = color.rgb(255, 57, 4)
colEntry = color.rgb(255, 223, 0)
colPanel = color.rgb(13, 15, 20)
colHeader = color.rgb(19, 2, 50)
colWait = color.rgb(120, 120, 120)

haTicker = ticker.heikinashi(syminfo.tickerid)
[haOpen, haHigh, haLow, haClose] = request.security(haTicker, timeframe.period, [open, high, low, close], barmerge.gaps_off, barmerge.lookahead_off)

tick = syminfo.mintick
atr = math.max(nz(ta.atr(14), tick), tick)
ema100 = ta.ema(close, emaLen)
emaBuffer = atr * emaChopAtr
emaSlope = ema100 - ema100[emaSlopeBars]
isOneMinute = timeframe.isminutes and timeframe.multiplier == 1
timeframeOk = not requireOneMinute or isOneMinute
inSession = not na(time(timeframe.period, tradeSession, sessionTimezone))
aboveEma = close > ema100 + emaBuffer
belowEma = close < ema100 - emaBuffer
inEmaChop = math.abs(close - ema100) <= emaBuffer
longTrend = aboveEma and (not requireEmaSlope or emaSlope > 0)
shortTrend = belowEma and (not requireEmaSlope or emaSlope < 0)

currentDay = dayofmonth(time)
var int storedDay = na
var int tradesToday = 0
if na(storedDay) or currentDay != storedDay
    storedDay := currentDay
    tradesToday := 0
dailyTradeOk = tradesToday < maxTradesPerDay

flatTol = tick * flatToleranceTicks
stopBuffer = tick * stopBufferTicks
minRisk = tick * minRiskTicks

isFlatTop(int barsBack) =>
    float bodyTop = math.max(haOpen[barsBack], haClose[barsBack])
    float upperWick = haHigh[barsBack] - bodyTop
    upperWick <= flatTol

isFlatBottom(int barsBack) =>
    float bodyBottom = math.min(haOpen[barsBack], haClose[barsBack])
    float lowerWick = bodyBottom - haLow[barsBack]
    lowerWick <= flatTol

hasTwoSidedWicks(int barsBack) =>
    float bodyTop = math.max(haOpen[barsBack], haClose[barsBack])
    float bodyBottom = math.min(haOpen[barsBack], haClose[barsBack])
    float upperWick = haHigh[barsBack] - bodyTop
    float lowerWick = bodyBottom - haLow[barsBack]
    upperWick > flatTol and lowerWick > flatTol

longPullbackReady = true
shortPullbackReady = true
for i = 1 to pullbackCandles
    bool longCandleOk = haClose[i] < haOpen[i] and isFlatTop(i) and not hasTwoSidedWicks(i)
    bool shortCandleOk = haClose[i] > haOpen[i] and isFlatBottom(i) and not hasTwoSidedWicks(i)
    longPullbackReady := longPullbackReady and longCandleOk
    shortPullbackReady := shortPullbackReady and shortCandleOk

longProgress = not requirePullbackProgress or haClose[1] < haClose[pullbackCandles]
shortProgress = not requirePullbackProgress or haClose[1] > haClose[pullbackCandles]
longPullbackReady := longPullbackReady and longProgress
shortPullbackReady := shortPullbackReady and shortProgress

haRange = math.max(haHigh - haLow, tick)
haBody = math.abs(haClose - haOpen)
haUpperWick = haHigh - math.max(haOpen, haClose)
haLowerWick = math.min(haOpen, haClose) - haLow
prevRange1 = math.max(haHigh[1] - haLow[1], tick)
prevRange2 = math.max(haHigh[2] - haLow[2], tick)
dojiShape = haBody <= haRange * maxBodyPct and haUpperWick >= haRange * minWickPct and haLowerWick >= haRange * minWickPct and haUpperWick >= haBody * minWickBodyRatio and haLowerWick >= haBody * minWickBodyRatio
rangeExpanded = not requireBiggerThanPrior or haRange > prevRange1 or haRange > prevRange2
volumeSpike = not useActualVolumeSpike or volume > ta.sma(volume, volumeLen) * volumeMultiplier
validDoji = dojiShape and rangeExpanded and volumeSpike

longStop = (stopUses == "Heikin Ashi Wick" ? haLow : low) - stopBuffer
shortStop = (stopUses == "Heikin Ashi Wick" ? haHigh : high) + stopBuffer
longRisk = close - longStop
shortRisk = shortStop - close
longRiskOk = longRisk >= minRisk and longRisk <= atr * maxRiskAtr
shortRiskOk = shortRisk >= minRisk and shortRisk <= atr * maxRiskAtr

flat = strategy.position_size == 0
longOpen = strategy.position_size > 0
shortOpen = strategy.position_size < 0
confirmed = barstate.isconfirmed

longSignal = confirmed and timeframeOk and inSession and dailyTradeOk and flat and longTrend and longPullbackReady and validDoji and longRiskOk
shortSignal = confirmed and timeframeOk and inSession and dailyTradeOk and flat and shortTrend and shortPullbackReady and validDoji and shortRiskOk

var float entryPrice = na
var float activeStop = na
var float riskPoints = na
var float maxReachedR = 0.0
var float target1 = na
var float target2 = na
var float target3 = na
var int entryBar = na
var line stopLine = na
var line oneRLine = na
var line twoRLine = na
var line threeRLine = na

resetLines() =>
    if not na(stopLine)
        line.delete(stopLine)
    if not na(oneRLine)
        line.delete(oneRLine)
    if not na(twoRLine)
        line.delete(twoRLine)
    if not na(threeRLine)
        line.delete(threeRLine)

if longSignal
    entryPrice := close
    activeStop := longStop
    riskPoints := longRisk
    maxReachedR := 0.0
    target1 := entryPrice + riskPoints
    target2 := entryPrice + riskPoints * 2.0
    target3 := entryPrice + riskPoints * 3.0
    entryBar := bar_index
    resetLines()
    stopLine := na
    oneRLine := na
    twoRLine := na
    threeRLine := na
    if showLevels
        stopLine := line.new(bar_index, activeStop, bar_index + 1, activeStop, extend=extend.right, color=color.new(colShort, 0), width=1)
        oneRLine := line.new(bar_index, target1, bar_index + 1, target1, extend=extend.right, color=color.new(colLong, 0), width=1)
        twoRLine := line.new(bar_index, target2, bar_index + 1, target2, extend=extend.right, color=color.new(colLong, 25), width=1)
        threeRLine := line.new(bar_index, target3, bar_index + 1, target3, extend=extend.right, color=color.new(colLong, 45), width=1)
    strategy.entry("Long", strategy.long, qty=contracts, alert_message=longEntryAlert)
    if showLabels
        label.new(bar_index, low - atr * 0.2, "BUY\nDoji", style=label.style_label_up, color=colEntry, textcolor=color.black, size=size.small)
    tradesToday += 1

if shortSignal
    entryPrice := close
    activeStop := shortStop
    riskPoints := shortRisk
    maxReachedR := 0.0
    target1 := entryPrice - riskPoints
    target2 := entryPrice - riskPoints * 2.0
    target3 := entryPrice - riskPoints * 3.0
    entryBar := bar_index
    resetLines()
    stopLine := na
    oneRLine := na
    twoRLine := na
    threeRLine := na
    if showLevels
        stopLine := line.new(bar_index, activeStop, bar_index + 1, activeStop, extend=extend.right, color=color.new(colShort, 0), width=1)
        oneRLine := line.new(bar_index, target1, bar_index + 1, target1, extend=extend.right, color=color.new(colLong, 0), width=1)
        twoRLine := line.new(bar_index, target2, bar_index + 1, target2, extend=extend.right, color=color.new(colLong, 25), width=1)
        threeRLine := line.new(bar_index, target3, bar_index + 1, target3, extend=extend.right, color=color.new(colLong, 45), width=1)
    strategy.entry("Short", strategy.short, qty=contracts, alert_message=shortEntryAlert)
    if showLabels
        label.new(bar_index, high + atr * 0.2, "SELL\nDoji", style=label.style_label_down, color=colEntry, textcolor=color.black, size=size.small)
    tradesToday += 1

barsInTrade = na(entryBar) ? 0 : bar_index - entryBar
scaleRunner = exitPlan == "Scale 1R / 2R / Runner"
oneROnly = exitPlan == "1R Only"
fullThreeR = exitPlan == "Full 3R Target"

if longOpen and not na(riskPoints)
    maxReachedR := math.max(maxReachedR, (high - entryPrice) / riskPoints)
    if useStepStopLadder and maxReachedR >= runnerBreakevenAtR
        float lockR = maxReachedR < runnerBreakevenAtR + 1.0 ? 0.0 : math.floor(maxReachedR) - 1.0
        activeStop := math.max(activeStop, entryPrice + riskPoints * lockR)
    if showLevels and not na(stopLine)
        line.set_y1(stopLine, activeStop)
        line.set_y2(stopLine, activeStop)
    if oneROnly
        strategy.exit("L 1R Full", "Long", stop=activeStop, limit=target1, alert_message=longExitAlert)
    else if scaleRunner
        strategy.exit("L 1R", "Long", qty_percent=33, stop=activeStop, limit=target1, alert_message=longExitAlert)
        strategy.exit("L 2R", "Long", qty_percent=33, stop=activeStop, limit=target2, alert_message=longExitAlert)
        strategy.exit("L Runner", "Long", qty_percent=34, stop=activeStop, alert_message=longExitAlert)
    else if fullThreeR
        strategy.exit("L 3R Full", "Long", stop=activeStop, limit=target3, alert_message=longExitAlert)

if shortOpen and not na(riskPoints)
    maxReachedR := math.max(maxReachedR, (entryPrice - low) / riskPoints)
    if useStepStopLadder and maxReachedR >= runnerBreakevenAtR
        float lockR = maxReachedR < runnerBreakevenAtR + 1.0 ? 0.0 : math.floor(maxReachedR) - 1.0
        activeStop := math.min(activeStop, entryPrice - riskPoints * lockR)
    if showLevels and not na(stopLine)
        line.set_y1(stopLine, activeStop)
        line.set_y2(stopLine, activeStop)
    if oneROnly
        strategy.exit("S 1R Full", "Short", stop=activeStop, limit=target1, alert_message=shortExitAlert)
    else if scaleRunner
        strategy.exit("S 1R", "Short", qty_percent=33, stop=activeStop, limit=target1, alert_message=shortExitAlert)
        strategy.exit("S 2R", "Short", qty_percent=33, stop=activeStop, limit=target2, alert_message=shortExitAlert)
        strategy.exit("S Runner", "Short", qty_percent=34, stop=activeStop, alert_message=shortExitAlert)
    else if fullThreeR
        strategy.exit("S 3R Full", "Short", stop=activeStop, limit=target3, alert_message=shortExitAlert)

timeExit = confirmed and not flat and barsInTrade >= maxBarsInTrade
sessionExit = confirmed and not flat and not inSession
if timeExit or sessionExit
    if longOpen
        strategy.close("Long", comment=timeExit ? "Time Exit" : "Session Exit", alert_message=longExitAlert)
    if shortOpen
        strategy.close("Short", comment=timeExit ? "Time Exit" : "Session Exit", alert_message=shortExitAlert)
    if showLabels
        label.new(bar_index, close, timeExit ? "Time Exit" : "Session Exit", style=label.style_label_center, color=color.new(colWait, 0), textcolor=color.white, size=size.tiny)
    entryPrice := na
    activeStop := na
    riskPoints := na
    maxReachedR := 0.0
    target1 := na
    target2 := na
    target3 := na
    entryBar := na

if flat and not longSignal and not shortSignal
    entryPrice := na
    activeStop := na
    riskPoints := na
    maxReachedR := 0.0
    target1 := na
    target2 := na
    target3 := na
    entryBar := na

plot(ema100, "100 EMA", color=color.new(color.white, 0), linewidth=2)
plot(ema100 + emaBuffer, "EMA Chop Upper", color=color.new(color.gray, 82))
plot(ema100 - emaBuffer, "EMA Chop Lower", color=color.new(color.gray, 82))
haColor = haClose >= haOpen ? color.new(colLong, 0) : color.new(colShort, 0)
plotcandle(colorCandles ? haOpen : na, colorCandles ? haHigh : na, colorCandles ? haLow : na, colorCandles ? haClose : na, title="Heikin Ashi Logic Candles", color=haColor, wickcolor=haColor, bordercolor=haColor, display=display.pane)
bgcolor(not inSession ? color.new(colWait, 93) : inEmaChop ? color.new(color.orange, 90) : na, title="No Trade Zone")

plotshape(showSetupMarkers and longTrend and longPullbackReady, "Long Pullback Ready", shape.circle, location.belowbar, color=color.new(colLong, 10), size=size.tiny, text="PB")
plotshape(showSetupMarkers and shortTrend and shortPullbackReady, "Short Pullback Ready", shape.circle, location.abovebar, color=color.new(colShort, 10), size=size.tiny, text="PB")
plotshape(showSetupMarkers and validDoji and longPullbackReady, "Long Doji", shape.diamond, location.belowbar, color=colEntry, size=size.tiny, text="D")
plotshape(showSetupMarkers and validDoji and shortPullbackReady, "Short Doji", shape.diamond, location.abovebar, color=colEntry, size=size.tiny, text="D")

alertcondition(longSignal, "HA Checklist Long", "HA checklist long setup triggered")
alertcondition(shortSignal, "HA Checklist Short", "HA checklist short setup triggered")
alertcondition(timeExit or sessionExit, "HA Checklist Time/Session Exit", "HA checklist time/session exit")

var table dash = table.new(position.bottom_right, 2, 10, border_width=1)
if showDashboard and barstate.islast
    winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100.0 : na
    pf = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na
    status = not timeframeOk ? "Use 1m" : not inSession ? "Outside 10-12" : inEmaChop ? "EMA Chop" : longTrend ? "Longs Only" : shortTrend ? "Shorts Only" : "No Trend"
    pullbackStatus = longPullbackReady ? "Long PB" : shortPullbackReady ? "Short PB" : "Waiting"
    dojiStatus = validDoji ? "Valid Doji" : "No Doji"
    positionStatus = longOpen ? "Long" : shortOpen ? "Short" : "Flat"
    table.clear(dash, 0, 0, 1, 9)
    table.cell(dash, 0, 0, "HA Checklist", bgcolor=colHeader, text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, status, bgcolor=colHeader, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 1, "Position", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 1, positionStatus, bgcolor=colPanel, text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 2, "Pullback", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 2, pullbackStatus, bgcolor=colPanel, text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 3, "Doji", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 3, dojiStatus, bgcolor=colPanel, text_color=validDoji ? colEntry : color.white, text_size=size.tiny)
    table.cell(dash, 0, 4, "Trades Today", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 4, str.tostring(tradesToday) + " / " + str.tostring(maxTradesPerDay), bgcolor=colPanel, text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 5, "Max R", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 5, str.tostring(maxReachedR, "0.0"), bgcolor=colPanel, text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 6, "Net Profit", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 6, str.tostring(strategy.netprofit, format.mintick), bgcolor=colPanel, text_color=strategy.netprofit >= 0 ? colLong : colShort, text_size=size.tiny)
    table.cell(dash, 0, 7, "Closed Trades", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 7, str.tostring(strategy.closedtrades), bgcolor=colPanel, text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 8, "Win Rate", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 8, na(winRate) ? "-" : str.tostring(winRate, "0.0") + "%", bgcolor=colPanel, text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 9, "Profit Factor", bgcolor=colPanel, text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 9, na(pf) ? "-" : str.tostring(pf, "0.00"), bgcolor=colPanel, text_color=color.white, text_size=size.tiny)
